    parser.add_argument("--ka", type=float, required=True, help="equal-volume size parameter")
    parser.add_argument("--ri", type=float, required=True, help="real relative refractive index")
    parser.add_argument("--quality", choices=tuple(PROFILES), default="standard")
    parser.add_argument("--ref", type=int, help="surface refinement; automatic for built-in shapes")
    parser.add_argument(
        "--points-per-wavelength",
        type=float,
        help="override points per shortest external/interior wavelength",
    )
    parser.add_argument("--sides", type=int, default=6, help="number of prism sides")
    parser.add_argument("--aspect", type=float, default=1.0, help="prism height/diameter ratio")
    parser.add_argument("--obj", help="OBJ mesh for --shape obj")
    parser.add_argument("--out", help="output directory")
    parser.add_argument("--threads", type=int, default=min(16, os.cpu_count() or 1))
    parser.add_argument("--gpu", type=int, default=0)
    parser.add_argument("--binary", help="expert override for the solver executable")
    parser.add_argument("--cxx", default="g++-12")
    parser.add_argument("--cuda-home", default="/usr")
    parser.add_argument("--no-build", action="store_true")
    parser.add_argument("--allow-memory-risk", action="store_true")
