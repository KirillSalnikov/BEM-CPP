def plan_leaves(plan: dict[str, Any]) -> Iterable[dict[str, Any]]:
    if plan["kind"] in {
        "strict_suite", "physical_fast_suite", "profile_two_stage_suite",
        "adaptive_fast_suite",
    }:
        yield from plan["children"]
    else:
        yield plan


def enforce_memory(plan: dict[str, Any], allow_risk: bool) -> None:
    for leaf in plan_leaves(plan):
        status = gpu_memory_status_gib(int(leaf["runtime"]["gpu"]))
        if status is None:
            continue
        total, free = status
        estimated = float(leaf["estimate"]["gpu_memory_gib"])
        if leaf["quality"] == "preview":
            if min(total, free) < estimated and not allow_risk:
                fail(
                    f"the validated preview needs about {estimated:.1f} GiB, "
                    f"while GPU {leaf['runtime']['gpu']} has {free:.1f} GiB free "
                    f"of {total:.1f} GiB"
                )
            continue
        memory_policy = str(
            leaf.get("effective_parameters", {}).get("memory_policy", "")
        )
        sequential = "sequential_currents" in memory_policy
        total_fraction = 0.92 if sequential else 0.85
        safe_budget = min(total_fraction * total, max(0.0, free - 0.75))
        if estimated > safe_budget:
            message = (
                f"ref={leaf['inputs']['refinement']} is estimated to need "
                f"{estimated:.1f} GiB, while GPU {leaf['runtime']['gpu']} has "
                f"{free:.1f} GiB free of {total:.1f} GiB "
                f"({safe_budget:.1f} GiB safe budget)"
            )
            if not allow_risk:
                fail(
                    message + "; close other GPU jobs, choose a smaller --ref, "
                    "or use --allow-memory-risk"
                )
            print(f"warning: {message}", file=sys.stderr)

    checkpoint_need = max(
        (
            float(leaf.get("estimate", {}).get("checkpoint_disk_gib", 0.0))
            for leaf in plan_leaves(plan)
        ),
        default=0.0,
    )
    if checkpoint_need <= 0.0:
        return
    output = Path(plan["output_directory"])
    probe = output
    while not probe.exists() and probe != probe.parent:
        probe = probe.parent
    free_disk = shutil.disk_usage(probe).free / (1024.0 ** 3)
    # Atomic replacement temporarily keeps the old and new checkpoint.
    required_disk = max(0.25, 2.0 * checkpoint_need + 0.1)
    if free_disk < required_disk:
        message = (
            f"checkpoints need about {required_disk:.2f} GiB of temporary "
            f"disk space, but {probe} has {free_disk:.2f} GiB free"
        )
        if not allow_risk:
            fail(message + "; free disk space or use --allow-memory-risk")
        print(f"warning: {message}", file=sys.stderr)


def write_json_atomic(path: Path, data: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(
        json.dumps(data, indent=2, ensure_ascii=False) + "\n",
        encoding="utf-8",
    )
    temporary.replace(path)


def write_execution_state(
    plan: dict[str, Any], status: str, **details: Any,
) -> None:
    state = {
        "schema_version": 1,
        "updated_at_utc": utc_now(),
        "status": status,
        "quality": plan["quality"],
        "calculation_kind": plan.get("calculation_kind", plan["kind"]),
        "result_path": plan.get("result_path"),
    }
    state.update(details)
    write_json_atomic(
        Path(plan["output_directory"]) / "execution_state.json", state
    )


def usable_solver_checkpoint(path: Path, dofs: int) -> bool:
    try:
        # Header plus one complex<double> solution vector.  A shorter file is
        # necessarily interrupted/corrupt and must not skip the preview.
        return path.stat().st_size >= 64 + 16 * dofs
    except OSError:
        return False


def write_single_files(plan: dict[str, Any]) -> None:
    output = Path(plan["output_directory"])
    output.mkdir(parents=True, exist_ok=True)
    write_json_atomic(output / CONFIG_NAME, plan)
    runtime = plan["runtime"]
    script = (
        "#!/usr/bin/env bash\n"
        "set -euo pipefail\n"
        f"export OMP_NUM_THREADS={shlex.quote(str(runtime['threads']))}\n"
        f"export CUDA_VISIBLE_DEVICES={shlex.quote(str(runtime['gpu']))}\n"
    )
    for name, value in runtime.get("environment", {}).items():
        script += f"export {name}={shlex.quote(str(value))}\n"
    script += f"exec {shlex.join(plan['command'])}\n"
    command_path = output / "command.sh"
    command_path.write_text(script, encoding="utf-8")
    command_path.chmod(0o755)


def write_plan_files(plan: dict[str, Any]) -> None:
    output = Path(plan["output_directory"])
    output.mkdir(parents=True, exist_ok=True)
    write_json_atomic(output / CONFIG_NAME, plan)
    for leaf in plan_leaves(plan):
        write_single_files(leaf)


def ensure_binary(plan: dict[str, Any], no_build: bool) -> None:
    binary = Path(plan["runtime"]["binary"])
    if binary.is_file() and os.access(binary, os.X_OK):
        return
    target = plan["runtime"]["build_target"]
    if no_build or not target:
        fail(f"missing executable {binary}")
    command = [
        "make", target,
        f"CXX={plan['runtime']['cxx']}",
        f"CUDA_HOME={plan['runtime']['cuda_home']}",
        f"-j{max(1, int(plan['runtime']['threads']))}",
    ]
    print(f"Building solver: {shlex.join(command)}")
    completed = subprocess.run(command, cwd=ROOT, check=False)
    if completed.returncode != 0:
        fail(f"build failed with code {completed.returncode}", 1)


def residuals(data: dict[str, Any]) -> list[float]:
    values: list[float] = []
    if isinstance(data.get("iterations"), dict):
        value = data["iterations"].get("maximum_residual")
        if value is not None:
            values.append(float(value))
    if isinstance(data.get("mbj"), dict):
        value = data["mbj"].get("fmm_residual")
        if value is not None:
            values.append(float(value))
    if isinstance(data.get("physical"), dict):
        value = data["physical"].get("parallel_fmm_residual")
        if value is not None:
            values.append(float(value))
    return values


def mueller_data(data: dict[str, Any]) -> tuple[list[float], list[Any]] | None:
    if isinstance(data.get("physical"), dict):
        theta = data["physical"].get("theta_degrees")
        mueller = data["physical"].get("mueller")
    else:
        theta = data.get("theta_degrees")
        mueller = data.get("mueller")
    if not isinstance(theta, list) or not isinstance(mueller, list):
        return None
    return theta, mueller


def flatten(values: Any) -> list[float]:
    if isinstance(values, list):
        result: list[float] = []
        for value in values:
            result.extend(flatten(value))
        return result
    return [float(values)]


def interpolate_series(
    source_x: list[float], source_y: list[float], target_x: list[float]
) -> list[float]:
    if len(source_x) != len(source_y) or len(source_x) < 2:
        fail("Mueller comparison requires at least two matching angular samples")
    if any(b <= a for a, b in zip(source_x, source_x[1:])):
        fail("Mueller comparison angles must be strictly increasing")
    if not target_x or any(b <= a for a, b in zip(target_x, target_x[1:])):
        fail("target Mueller comparison angles must be strictly increasing")
    if target_x[0] < source_x[0] or target_x[-1] > source_x[-1]:
        fail("Mueller comparison angle ranges do not overlap completely")
    result: list[float] = []
    lower = 0
    for target in target_x:
        while lower + 1 < len(source_x) and source_x[lower + 1] < target:
            lower += 1
        if target == source_x[lower]:
            result.append(source_y[lower])
            continue
        upper = min(lower + 1, len(source_x) - 1)
        if target == source_x[upper]:
            result.append(source_y[upper])
            continue
        fraction = (target - source_x[lower]) / (source_x[upper] - source_x[lower])
        result.append(source_y[lower] + fraction * (source_y[upper] - source_y[lower]))
    return result


def resample_mueller(
    source_theta: list[float], source_mueller: list[Any], target_theta: list[float]
) -> list[Any]:
    if len(source_mueller) != 4 or any(len(row) != 4 for row in source_mueller):
        fail("Mueller comparison requires a 4x4 matrix layout")
    return [
        [
            interpolate_series(source_theta, [float(value) for value in values], target_theta)
            for values in row
        ]
        for row in source_mueller
    ]


def inspect_result(
    path: Path,
    require_physical: bool = True,
    enforce_tolerance: bool = True,
) -> tuple[dict[str, Any], bool]:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        return {"path": str(path), "errors": [str(error)], "warnings": []}, False

    errors: list[str] = []
    warnings: list[str] = []
    tolerance = float(data.get("tolerance", 0.0))
    found_residuals = residuals(data)
    pfft_metadata = data.get("pfft_fgmres")
    residual_verified = not (
        isinstance(pfft_metadata, dict)
        and pfft_metadata.get("fmm_residual_verified") is False
    )
    if not found_residuals:
        errors.append("no final residual found")
    elif tolerance <= 0.0:
        errors.append("missing positive tolerance")
    elif enforce_tolerance and max(found_residuals) > 2.0 * tolerance:
        errors.append(
            f"maximum residual {max(found_residuals):.3e} exceeds 2*tolerance"
        )
    if found_residuals and not residual_verified:
        warnings.append(
            "final residual is an explicitly trusted Krylov projection, "
            "not an independently verified full-operator residual"
        )

    physical_metadata = data.get("physical")
    if isinstance(physical_metadata, dict):
        if physical_metadata.get("trusted_cyclic_exact_geometry_used") is True:
            errors.append(
                "second polarization was accepted without a direct operator "
                "residual check"
            )
        if require_physical:
            parallel_residual = physical_metadata.get("parallel_fmm_residual")
            if (
                parallel_residual is None
                or not math.isfinite(float(parallel_residual))
                or float(parallel_residual) < 0.0
            ):
                errors.append(
                    "verified second-polarization operator residual is missing"
                )

    physical = mueller_data(data)
    if physical is None and require_physical:
        errors.append("Mueller matrix is missing")
    elif physical is not None:
        theta, mueller = physical
        flat = flatten(mueller)
        if not theta or not flat:
            errors.append("Mueller matrix is empty")
        elif not all(math.isfinite(value) for value in flat):
            errors.append("Mueller matrix contains non-finite values")

    if data.get("software_version") is None:
        warnings.append("software_version is absent (pre-release result)")
    adaptive = data.get("adaptive")
    if isinstance(adaptive, dict) and adaptive.get("enabled"):
        if not adaptive.get("converged"):
            errors.append(
                "adaptive orientation averaging reached its maximum level "
                "without satisfying convergence tolerances"
            )
    if data.get("hdiv_conforming") and not data.get("sharp_edge_formulation_validated"):
        warnings.append("sharp-edge H(div) result still requires independent validation")
    report = {
        "path": str(path),
        "software_version": data.get("software_version"),
        "solver": data.get("solver"),
        "tolerance": tolerance,
        "maximum_residual": max(found_residuals) if found_residuals else None,
        "target_met": bool(
            found_residuals
            and tolerance > 0.0
            and max(found_residuals) <= tolerance
        ),
        "residual_verified": residual_verified,
        "errors": errors,
        "warnings": warnings,
    }
    return report, not errors


def compare_results(first_path: Path, second_path: Path) -> dict[str, Any]:
    first = json.loads(first_path.read_text(encoding="utf-8"))
    second = json.loads(second_path.read_text(encoding="utf-8"))
    first_physical = mueller_data(first)
    second_physical = mueller_data(second)
    if first_physical is None or second_physical is None:
        fail("both comparison results must contain Mueller matrices")
    first_theta, first_mueller = first_physical
    second_theta, second_mueller = second_physical
    interpolated = first_theta != second_theta
    interpolation_target = "none"
    comparison_theta = first_theta
    if interpolated:
        # Preserve the coarser native angular data.  Upsampling a sparse,
        # rapidly oscillating high-ka curve creates artificial agreement or
        # disagreement between its actual samples.
        if len(first_theta) <= len(second_theta):
            second_mueller = resample_mueller(
                second_theta, second_mueller, first_theta
            )
            interpolation_target = "reference_to_candidate_grid"
        else:
            first_mueller = resample_mueller(
                first_theta, first_mueller, second_theta
            )
            comparison_theta = second_theta
            interpolation_target = "candidate_to_reference_grid"
    a = flatten(first_mueller)
    b = flatten(second_mueller)
    if len(a) != len(b) or not a:
        fail("comparison results use incompatible Mueller layouts")
    a0 = float(first_mueller[0][0][0])
    b0 = float(second_mueller[0][0][0])
    if a0 == 0.0 or b0 == 0.0:
        fail("M11(0) is zero in a comparison result")
    an = [value / a0 for value in a]
    bn = [value / b0 for value in b]
    raw_den = math.sqrt(sum(value * value for value in b)) or 1.0
    norm_den = math.sqrt(sum(value * value for value in bn)) or 1.0
    return {
        "comparison_angles": len(comparison_theta),
        "reference_interpolated": interpolated,
        "interpolation_target": interpolation_target,
        "raw_relative_l2": math.sqrt(sum((x - y) ** 2 for x, y in zip(a, b))) / raw_den,
        "normalized_relative_l2": math.sqrt(
            sum((x - y) ** 2 for x, y in zip(an, bn))
        ) / norm_den,
        "maximum_normalized_absolute_difference": max(
            abs(x - y) for x, y in zip(an, bn)
        ),
        "forward_m11_ratio": a0 / b0,
        "forward_relative_difference": abs(a0 / b0 - 1.0),
    }


def solid_angle_weights(theta_degrees: list[float]) -> list[float]:
    if len(theta_degrees) < 2:
        fail("observable stability requires at least two scattering angles")
    theta = [math.radians(float(value)) for value in theta_degrees]
    if any(right <= left for left, right in zip(theta, theta[1:])):
        fail("observable stability angles must be strictly increasing")
    weights: list[float] = []
    for index, angle in enumerate(theta):
        if index == 0:
            width = 0.5 * (theta[1] - theta[0])
        elif index == len(theta) - 1:
            width = 0.5 * (theta[-1] - theta[-2])
        else:
            width = 0.5 * (theta[index + 1] - theta[index - 1])
        weights.append(max(0.0, math.sin(angle) * width))
    if sum(weights) <= 0.0:
        fail("observable stability solid-angle weights are zero")
    return weights


def extinction_observable(data: dict[str, Any]) -> float:
    physical = data.get("physical")
    amplitudes = physical.get("amplitudes") if isinstance(physical, dict) else None
    if not isinstance(amplitudes, dict):
        fail("adaptive fast requires forward amplitudes for extinction control")
    forward: list[float] = []
    for name in ("S1", "S2"):
        values = amplitudes.get(name)
        if (
            not isinstance(values, list)
            or not values
            or not isinstance(values[0], list)
            or len(values[0]) != 2
        ):
            fail(f"adaptive fast requires a complex forward {name} amplitude")
        forward.append(float(values[0][0]))
    value = sum(forward)
    if not math.isfinite(value) or value == 0.0:
        fail("adaptive fast encountered a zero/non-finite extinction observable")
    # In the solver's Bohren-Huffman amplitude convention the unpolarized
    # optical-theorem extinction is proportional to Re[S1(0)+S2(0)].  Its
    # constant scale and convention-dependent sign cancel between levels.
    return value


def observable_stability_metrics(
    previous_path: Path,
    current_path: Path,
    relative_tolerance: float = FAST_OBSERVABLE_RELATIVE_TOLERANCE,
) -> dict[str, Any]:
    previous = json.loads(previous_path.read_text(encoding="utf-8"))
    current = json.loads(current_path.read_text(encoding="utf-8"))
    previous_physical = mueller_data(previous)
    current_physical = mueller_data(current)
    if previous_physical is None or current_physical is None:
        fail("adaptive fast requires Mueller matrices at every exact level")
    previous_theta, previous_mueller = previous_physical
    current_theta, current_mueller = current_physical
    interpolation_target = "none"
    theta = previous_theta
    if previous_theta != current_theta:
        if len(previous_theta) <= len(current_theta):
            current_mueller = resample_mueller(
                current_theta, current_mueller, previous_theta
            )
            interpolation_target = "current_to_previous_grid"
        else:
            previous_mueller = resample_mueller(
                previous_theta, previous_mueller, current_theta
            )
            theta = current_theta
            interpolation_target = "previous_to_current_grid"

    previous_forward = float(previous_mueller[0][0][0])
    current_forward = float(current_mueller[0][0][0])
    if previous_forward == 0.0 or current_forward == 0.0:
        fail("adaptive fast cannot normalize a zero forward M11")
    weights = solid_angle_weights([float(value) for value in theta])

    weighted_difference = 0.0
    weighted_reference = 0.0
    weighted_m11_difference = 0.0
    weighted_m11_reference = 0.0
    maximum_normalized_difference = 0.0
    for row in range(4):
        for column in range(4):
            for angle, weight in enumerate(weights):
                old = float(previous_mueller[row][column][angle]) / previous_forward
                new = float(current_mueller[row][column][angle]) / current_forward
                difference = new - old
                weighted_difference += weight * difference * difference
                weighted_reference += weight * new * new
                maximum_normalized_difference = max(
                    maximum_normalized_difference, abs(difference)
                )
                if row == 0 and column == 0:
                    weighted_m11_difference += weight * difference * difference
                    weighted_m11_reference += weight * new * new

    previous_integral = sum(
        weight * float(previous_mueller[0][0][angle])
        for angle, weight in enumerate(weights)
    )
    current_integral = sum(
        weight * float(current_mueller[0][0][angle])
        for angle, weight in enumerate(weights)
    )
    if current_integral == 0.0:
        fail("adaptive fast encountered a zero integrated M11")
    previous_extinction = extinction_observable(previous)
    current_extinction = extinction_observable(current)

    full_l2 = math.sqrt(
        weighted_difference / max(weighted_reference, sys.float_info.min)
    )
    m11_l2 = math.sqrt(
        weighted_m11_difference
        / max(weighted_m11_reference, sys.float_info.min)
    )
    forward_difference = abs(previous_forward / current_forward - 1.0)
    integral_difference = abs(previous_integral / current_integral - 1.0)
    extinction_difference = abs(
        previous_extinction / current_extinction - 1.0
    )
    passes = all(
        value <= relative_tolerance
        for value in (
            full_l2,
            m11_l2,
            forward_difference,
            integral_difference,
            extinction_difference,
        )
    )
    return {
        "previous_result": str(previous_path),
        "current_result": str(current_path),
        "comparison_angles": len(theta),
        "interpolation_target": interpolation_target,
        "relative_tolerance": relative_tolerance,
        "solid_angle_weighted_normalized_full_mueller_l2": full_l2,
        "solid_angle_weighted_normalized_m11_l2": m11_l2,
        "forward_m11_relative_difference": forward_difference,
        "integrated_m11_relative_difference": integral_difference,
        "optical_theorem_extinction_relative_difference": (
            extinction_difference
        ),
        "maximum_forward_normalized_element_difference": (
            maximum_normalized_difference
        ),
        "passes": passes,
    }


def result_is_complete(
    plan: dict[str, Any], require_physical: bool = True,
) -> bool:
    path = Path(plan["result_path"])
    return path.is_file() and inspect_result(path, require_physical)[1]


def run_process(
    plan: dict[str, Any], no_build: bool, resume: bool,
    require_physical: bool = True,
    enforce_tolerance: bool = True,
) -> dict[str, Any]:
    if resume and result_is_complete(plan, require_physical):
        print(f"Already complete: {plan['result_path']}")
        validation_path = Path(plan["output_directory"]) / "validation.json"
        if validation_path.is_file():
            return json.loads(validation_path.read_text(encoding="utf-8"))
        report, _ = inspect_result(
            Path(plan["result_path"]), require_physical
        )
        return report
    started = time.monotonic()
    ensure_binary(plan, no_build)
    output = Path(plan["output_directory"])
    environment = os.environ.copy()
    environment["OMP_NUM_THREADS"] = str(plan["runtime"]["threads"])
    environment["CUDA_VISIBLE_DEVICES"] = str(plan["runtime"]["gpu"])
    environment.update(
        {
            str(name): str(value)
            for name, value in plan["runtime"].get("environment", {}).items()
        }
    )
    log_path = output / "run.log"
    print(f"Running: {shlex.join(plan['command'])}")
    sys.stdout.flush()
    with log_path.open("a", encoding="utf-8") as log:
        process = subprocess.Popen(
            plan["command"],
            cwd=ROOT,
            env=environment,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            bufsize=1,
        )
        assert process.stdout is not None
        for line in process.stdout:
            print(line, end="")
            log.write(line)
            log.flush()
        return_code = process.wait()
    if return_code != 0:
        fail(
            f"solver exited with code {return_code}; see {log_path}",
            return_code if return_code > 0 else 1,
        )
    report, valid = inspect_result(
        Path(plan["result_path"]), require_physical, enforce_tolerance
    )
    report["wall_time_s"] = time.monotonic() - started
    write_json_atomic(output / "validation.json", report)
    if not valid:
        fail(f"result validation failed; see {output / 'validation.json'}", 1)
    print(f"Finished: {plan['result_path']}")
    print(f"Validation: PASS ({output / 'validation.json'})")
    return report


def publish_adaptive_fast_result(
    source: Path, destination: Path,
) -> dict[str, Any]:
    destination.parent.mkdir(parents=True, exist_ok=True)
    temporary = destination.with_suffix(destination.suffix + ".tmp")
    shutil.copy2(source, temporary)
    temporary.replace(destination)
    report, valid = inspect_result(destination, require_physical=True)
    if not valid or not report.get("residual_verified", False):
        fail("selected adaptive fast result failed final validation", 1)
    write_json_atomic(destination.parent / "validation.json", report)
    return report


def execute_adaptive_fast(
    plan: dict[str, Any], no_build: bool, resume: bool,
) -> None:
    output = Path(plan["output_directory"])
    summary_path = output / "adaptive_fast_summary.json"
    final_path = Path(plan["result_path"])
    if resume and summary_path.is_file() and final_path.is_file():
        final_report, valid = inspect_result(final_path, require_physical=True)
        if valid and final_report.get("residual_verified", False):
            print(f"Already complete: {final_path}")
            write_execution_state(
                plan, "complete", resumed=True,
                summary_path=str(summary_path),
            )
            return

    children = plan["children"]
    preview_count = int(plan.get("preview_stage_count", 0))
    preview_report: dict[str, Any] | None = None
    if preview_count:
        preview = children[0]
        checkpoint_file = Path(
            plan["checkpoint_prefix"] + ".FMM_pFFT_FGMRES.bin"
        )
        preview_validation = (
            Path(preview["output_directory"]) / "validation.json"
        )
        if resume and usable_solver_checkpoint(
            checkpoint_file, int(preview["estimate"]["system_dofs"])
        ):
            print(f"Using saved adaptive-fast checkpoint: {checkpoint_file}")
            if preview_validation.is_file():
                preview_report = json.loads(
                    preview_validation.read_text(encoding="utf-8")
                )
            else:
                preview_report = {"wall_time_s": 0.0, "resumed": True}
        else:
            write_execution_state(
                plan, "preview_running", resumed=resume,
                checkpoint=str(checkpoint_file),
            )
            preview_report = run_process(
                preview,
                no_build,
                resume=False,
                require_physical=False,
                enforce_tolerance=False,
            )

    exact_stages = children[preview_count:]
    comparisons: list[dict[str, Any]] = []
    exact_reports: list[dict[str, Any]] = []
    consecutive_stable = 0
    previous_stage: dict[str, Any] | None = None
    selected_stage: dict[str, Any] | None = None
    selected_tolerance: float | None = None
    observable_tolerance = float(
        plan["validation_envelope"]["observable_relative_tolerance"]
    )
    required_stable = int(
        plan["validation_envelope"]["required_consecutive_stable_levels"]
    )
    minimum_early_residual = float(
        plan["validation_envelope"]["minimum_early_stop_residual"]
    )
    minimum_reduction = float(
        plan["validation_envelope"]["minimum_residual_reduction_factor"]
    )

    for stage in exact_stages:
        tolerance = float(stage["effective_parameters"]["tolerance"])
        write_execution_state(
            plan,
            "exact_level_running",
            resumed=resume,
            tolerance=tolerance,
            completed_exact_levels=len(exact_reports),
        )
        report = run_process(
            stage, no_build, resume=resume, require_physical=True
        )
        exact_reports.append(report)
        residual = report.get("maximum_residual")
        if residual is None or float(residual) > tolerance:
            fail(
                "adaptive fast exact residual gate failed: "
                f"{residual} > {tolerance:g}",
                1,
            )
        if not report.get("residual_verified", False):
            fail("adaptive fast requires a verified full-operator residual", 1)

        if previous_stage is not None:
            previous_residual = float(
                exact_reports[-2]["maximum_residual"]
            )
            current_residual = float(residual)
            residual_reduction = (
                previous_residual / current_residual
                if current_residual > 0.0 else math.inf
            )
            independent_update = residual_reduction >= minimum_reduction
            stability = observable_stability_metrics(
                Path(previous_stage["result_path"]),
                Path(stage["result_path"]),
                observable_tolerance,
            )
            stability.update({
                "previous_residual_target": float(
                    previous_stage["effective_parameters"]["tolerance"]
                ),
                "current_residual_target": tolerance,
                "previous_exact_residual": previous_residual,
                "current_exact_residual": current_residual,
                "residual_reduction_factor": residual_reduction,
                "minimum_residual_reduction_factor": minimum_reduction,
                "independent_residual_update": independent_update,
            })
            comparisons.append(stability)
            write_json_atomic(
                Path(stage["output_directory"]) / "observable_stability.json",
                stability,
            )
            if independent_update:
                consecutive_stable = (
                    consecutive_stable + 1 if stability["passes"] else 0
                )
            print(
                "Adaptive fast observables: "
                f"full={stability['solid_angle_weighted_normalized_full_mueller_l2']:.3e}, "
                f"M11={stability['solid_angle_weighted_normalized_m11_l2']:.3e}, "
                f"forward={stability['forward_m11_relative_difference']:.3e}, "
                f"integral={stability['integrated_m11_relative_difference']:.3e}; "
                f"extinction={stability['optical_theorem_extinction_relative_difference']:.3e}; "
                + (
                    f"stable {consecutive_stable}/{required_stable}"
                    if independent_update else
                    "not counted (no independent residual reduction)"
                )
            )

        previous_stage = stage
        if (
            tolerance <= minimum_early_residual
            and tolerance > float(PROFILES["standard"].tolerance)
            and consecutive_stable >= required_stable
        ):
            selected_stage = stage
            selected_tolerance = tolerance
            break

    if selected_stage is None:
        if not exact_reports or previous_stage is None:
            fail("adaptive fast produced no exact result", 1)
        selected_stage = previous_stage
        selected_tolerance = float(
            selected_stage["effective_parameters"]["tolerance"]
        )
        if selected_tolerance > float(PROFILES["standard"].tolerance):
            fail("adaptive fast did not reach its standard fallback", 1)

    final_report = publish_adaptive_fast_result(
        Path(selected_stage["result_path"]), final_path
    )
    preview_wall = float(
        preview_report.get("wall_time_s", 0.0) if preview_report else 0.0
    )
    exact_wall = sum(
        float(report.get("wall_time_s", 0.0)) for report in exact_reports
    )
    standard_tolerance = float(PROFILES["standard"].tolerance)
    summary = {
        "quality": plan["quality"],
        "selection": (
            "observable_stability_early_stop"
            if selected_tolerance > standard_tolerance
            else "standard_residual_fallback"
        ),
        "selected_residual_target": selected_tolerance,
        "selected_result_source": selected_stage["result_path"],
        "result_path": str(final_path),
        "preview_wall_time_s": preview_wall,
        "exact_wall_time_s": exact_wall,
        "pipeline_wall_time_s": preview_wall + exact_wall,
        "completed_exact_levels": len(exact_reports),
        "consecutive_stable_levels": consecutive_stable,
        "validation_envelope": plan["validation_envelope"],
        "observable_comparisons": comparisons,
        "result_validation": final_report,
    }
    write_json_atomic(summary_path, summary)
    write_execution_state(
        plan, "complete", resumed=resume,
        summary_path=str(summary_path),
        selected_residual_target=selected_tolerance,
        selection=summary["selection"],
    )
    print(
        "Adaptive fast complete: "
        f"{summary['selection']}, residual target {selected_tolerance:.0e}"
    )
    print(f"Adaptive fast summary: {summary_path}")


def execute_plan(plan: dict[str, Any], no_build: bool, resume: bool) -> None:
    started = time.monotonic()
    write_plan_files(plan)
    write_execution_state(plan, "running", resumed=resume)
    if plan["kind"] == "adaptive_fast_suite":
        execute_adaptive_fast(plan, no_build, resume)
        return
    if plan["kind"] in {"physical_fast_suite", "profile_two_stage_suite"}:
        stage1, stage2 = plan["children"]
        checkpoint_file = Path(
            plan["checkpoint_prefix"] + ".FMM_pFFT_FGMRES.bin"
        )
        stage1_validation = Path(stage1["output_directory"]) / "validation.json"
        checkpoint_ready = usable_solver_checkpoint(
            checkpoint_file, int(stage1["estimate"]["system_dofs"])
        )
        if resume and checkpoint_ready:
            print(f"Using saved stage-1 checkpoint: {checkpoint_file}")
            if stage1_validation.is_file():
                stage1_report = json.loads(
                    stage1_validation.read_text(encoding="utf-8")
                )
            else:
                stage1_report = {"wall_time_s": 0.0, "resumed": True}
        else:
            write_execution_state(
                plan, "stage1_running", resumed=resume,
                checkpoint=str(checkpoint_file),
            )
            stage1_report = run_process(
                stage1, no_build, resume=False, require_physical=False
            )
        write_execution_state(
            plan, "stage1_complete", resumed=resume,
            checkpoint=str(checkpoint_file),
        )
        write_execution_state(
            plan, "stage2_running", resumed=resume,
            checkpoint=str(checkpoint_file),
        )
        stage2_report = run_process(
            stage2, no_build, resume=resume, require_physical=True
        )
        target_residual = float(
            plan["validation_envelope"]["maximum_exact_operator_residual"]
        )
        measured_residual = stage2_report.get("maximum_residual")
        if (
            measured_residual is None
            or float(measured_residual) > target_residual
        ):
            fail(
                "two-stage exact residual gate failed: "
                f"{measured_residual} > {target_residual:g}",
                1,
            )
        if not stage2_report.get("residual_verified", False):
            fail("two-stage full-operator residual verification failed", 1)
        stage1_wall = float(stage1_report.get("wall_time_s", 0.0))
        stage2_wall = float(stage2_report.get("wall_time_s", 0.0))
        pipeline_wall = stage1_wall + stage2_wall
        summary = {
            "quality": plan["quality"],
            "stage1_wall_time_s": stage1_wall,
            "stage2_wall_time_s": stage2_wall,
            "pipeline_wall_time_s": pipeline_wall,
            "result_path": stage2["result_path"],
            "validation_envelope": plan["validation_envelope"],
            "result_validation": stage2_report,
        }
        summary_name = (
            "physical_fast_summary.json"
            if plan["kind"] == "physical_fast_suite"
            else "two_stage_summary.json"
        )
        summary_path = Path(plan["output_directory"]) / summary_name
        write_json_atomic(summary_path, summary)
        print(f"Two-stage summary: {summary_path}")
        write_execution_state(
            plan, "complete", resumed=resume,
            summary_path=str(summary_path),
        )
        return
    if plan["kind"] != "strict_suite":
        run_process(plan, no_build, resume)
        write_execution_state(plan, "complete", resumed=resume)
        return
    for child in plan["children"]:
        run_process(child, no_build, resume)
    comparison = compare_results(
        Path(plan["comparison"]["coarse"]),
        Path(plan["comparison"]["fine"]),
    )
    comparison["passes"] = (
        comparison["normalized_relative_l2"] <=
        plan["comparison"]["maximum_normalized_relative_l2"]
        and comparison["forward_relative_difference"] <=
        plan["comparison"]["maximum_forward_relative_difference"]
    )
    comparison["suite_wall_time_s"] = time.monotonic() - started
    write_json_atomic(Path(plan["output_directory"]) / "mesh_convergence.json", comparison)
    if not comparison["passes"]:
        fail("strict two-mesh convergence gate failed", 1)
    write_execution_state(
        plan, "complete", resumed=resume,
        comparison_path=str(
            Path(plan["output_directory"]) / "mesh_convergence.json"
        ),
    )
    print("Strict two-mesh convergence gate: passed")


def command_calculate(args: argparse.Namespace, kind: str) -> int:
    plan = create_plan(args, kind)
    print_plan(plan, args.json)
    sys.stdout.flush()
    enforce_memory(plan, args.allow_memory_risk)
    if args.dry_run:
        return 0
    output = Path(plan["output_directory"])
    if output.exists() and any(output.iterdir()):
        fail(f"output directory is not empty: {output}; use 'bem resume {output}'")
    if plan["kind"] == "strict_suite" and not args.yes:
        if not sys.stdin.isatty():
            fail("strict mode requires --yes in a non-interactive session")
        answer = input("Run both FP64 refinements? [y/N] ").strip().lower()
        if answer not in {"y", "yes"}:
            print("Cancelled.")
            return 0
    execute_plan(plan, args.no_build, resume=False)
    return 0


def command_resume(args: argparse.Namespace) -> int:
    directory = Path(args.directory).expanduser().resolve()
    config = directory / CONFIG_NAME
    if not config.is_file():
        fail(f"missing {config}")
    plan = json.loads(config.read_text(encoding="utf-8"))
    for leaf in plan_leaves(plan):
        environment = leaf.setdefault("runtime", {}).setdefault("environment", {})
        if leaf.get("kind") == "average":
            environment["BEM_MULLER_GPU_ASSEMBLY"] = "1"
        profile = leaf.get("profile", {})
        effective = leaf.setdefault("effective_parameters", {})
        planned_memory_policy = str(effective.get("memory_policy", ""))
        forced_sequential = (
            "sequential_currents" in planned_memory_policy
            or "shared_operator" in planned_memory_policy
        )
        tolerance = effective.get("tolerance", profile.get("tolerance", 1.0))
        if profile.get("mixed_precision") and tolerance <= 1.0e-5:
            environment["BEM_MIXED_ITERATIVE_REFINEMENT"] = "1"
            environment["BEM_FMM_L2P_FP32"] = (
                "1"
                if effective.get("l2p_precision") ==
                "fp32_krylov_fp64_restart_residual"
                else "0"
            )
            effective["strict_residual_refinement"] = True
        if profile.get("compact_caches") or profile.get("low_memory"):
            environment["BEM_FMM_PHASE_CACHE"] = "0"
            environment["BEM_FMM_FLAT_NEAR_SOURCES"] = "0"
            if not forced_sequential:
                effective["memory_policy"] = (
                    "recompute_phases_and_direct_near_lists"
                )
        environment["BEM_FMM_PAIR_CURRENTS"] = (
            "0"
            if profile.get("sequential_currents") or forced_sequential
            else "1"
        )
        if effective.get("strict_residual_refinement") and (
            effective.get("solver") == "fmm_pfft_fgmres"
        ):
            effective["krylov_operator_policy"] = (
                "mixed_fmm_with_fp64_restart_residual"
            )
        else:
            effective["krylov_operator_policy"] = "profile_operator"
        if profile.get("sequential_currents") and not forced_sequential:
            effective["memory_policy"] = (
                "sequential_currents_and_recompute_caches"
            )
    print_plan(plan, args.json)
    enforce_memory(plan, args.allow_memory_risk)
    execute_plan(plan, args.no_build, resume=True)
    return 0


def command_validate(args: argparse.Namespace) -> int:
    path = Path(args.result).expanduser().resolve()
    report, valid = inspect_result(path)
    if args.reference:
        reference = Path(args.reference).expanduser().resolve()
        comparison = compare_results(path, reference)
        comparison["passes"] = (
            comparison["normalized_relative_l2"] <= args.max_normalized_l2
            and comparison["forward_relative_difference"] <= args.max_forward_difference
        )
        report["comparison"] = comparison
        valid = valid and comparison["passes"]
    if args.json:
        print(json.dumps(report, indent=2, ensure_ascii=False))
    else:
        print(f"Result: {'PASS' if valid else 'FAIL'}")
        print(f"  solver: {report.get('solver')}")
        print(f"  maximum residual: {report.get('maximum_residual')}")
        for warning in report["warnings"]:
            print(f"  warning: {warning}")
        for error in report["errors"]:
            print(f"  error: {error}")
        if "comparison" in report:
            print(
                "  normalized L2 difference: "
                f"{report['comparison']['normalized_relative_l2']:.3e}"
            )
            print(
                "  forward M11 difference: "
                f"{report['comparison']['forward_relative_difference']:.3e}"
            )
            if report["comparison"]["reference_interpolated"]:
                print("  reference Mueller matrix: linearly interpolated by angle")
    return 0 if valid else 1


def command_presets(args: argparse.Namespace) -> int:
    data = {name: asdict(profile) for name, profile in PROFILES.items()}
    if args.json:
        print(json.dumps(data, indent=2, ensure_ascii=False))
    else:
        for name, profile in PROFILES.items():
            print(f"{name:8s} {profile.purpose}")
    return 0


def command_explain(args: argparse.Namespace) -> int:
    profile = PROFILES[QUALITY_ALIASES.get(args.quality, args.quality)]
    if args.json:
        print(json.dumps(asdict(profile), indent=2, ensure_ascii=False))
        return 0
    precision = "mixed FP32/FP64" if profile.mixed_precision else "FP64"
    print(f"{profile.name}: {profile.purpose}")
    print(f"  precision: {precision}")
    print(f"  residual target: {profile.tolerance:.0e}")
    print(f"  angular samples: {profile.ntheta}")
    if profile.name == "fast":
        print(
            "  solver: exact FMM+MBJ correction ladder; optional pFFT "
            "warm start only when profitable"
        )
    elif profile.solver_policy == "adaptive_pfft":
        print("  solver: FMM+MBJ for ka<10; FMM+pFFT-FGMRES for ka>=10")
    else:
        print("  solver: FMM with MBJ")
    print(
        "  automatic mesh target: "
        f"{profile.points_per_wavelength:g} points/shortest wavelength"
    )
    print(
        "  adaptive averaging: "
        f"J={profile.orientation_minimum_level}..{profile.orientation_maximum_level}, "
        f"M11/integral/component tolerances "
        f"{profile.orientation_m11_tolerance:g}/"
        f"{profile.orientation_integral_tolerance:g}/"
        f"{profile.orientation_component_tolerance:g}"
    )
    if profile.name == "quick":
        print("  high contrast: Jmax=4 for m>=2; maximum iterations=400 for m>=2.5")
    elif profile.name == "preview":
        print("  validation domain: regular prism, ka=80, m=1.3, ref=6")
        print("  stopping rule: three outer steps; projected residual only")
        print("  polarization: C6 candidate followed by an operator check/correction")
        print("  measured physical error: 0.388% full-Mueller weighted L2")
    elif profile.name == "fast":
        levels = ", ".join(f"{value:.0e}" for value in FAST_RESIDUAL_LEVELS)
        print(f"  exact residual ladder: {levels}")
        print(
            "  early stop: two consecutive solid-angle-weighted Mueller, "
            "M11, forward-M11, integrated-M11, and optical-theorem "
            "extinction changes <= 1e-3"
        )
        print("  fallback: continue automatically to the standard 1e-5 target")
        print(
            "  startup: pFFT preview only when the high-frequency system is "
            "large enough to benefit; otherwise direct FMM+MBJ"
        )
    elif profile.name in {"standard", "memory"}:
        print("  high contrast: Jmax=5 for m>=2; MBJ100 for m>=2.5")
    if profile.name in {"quick", "standard", "memory"}:
        print(
            "  automatic fixed-orientation path: adaptive two-stage banded "
            "FMM for built-in meshes with ka>=60, ref>=4, and >=100000 "
            "estimated unknowns"
        )
        print(
            "  averaging: one operator setup and atomic per-orientation "
            "restart; paired GPU-GMRES is retained when available"
        )
    if profile.compact_caches:
        print("  memory: phase and flattened near-source caches are disabled")
    if profile.sequential_currents:
        print("  memory: electric and magnetic FMM currents are evaluated sequentially")
    if profile.two_meshes:
        print("  validation: two successive meshes and a Mueller-matrix comparison")
    return 0


def add_calculation_arguments(parser: argparse.ArgumentParser, average: bool) -> None:
    parser.add_argument("--shape", choices=("sphere", "cube", "prism", "obj"), required=True)
    parser.add_argument("--ka", type=float, required=True, help="equal-volume size parameter")
    parser.add_argument("--ri", type=float, required=True, help="real relative refractive index")
    parser.add_argument(
        "--quality",
        choices=tuple(PROFILES) + tuple(QUALITY_ALIASES),
        default="standard",
    )
    parser.add_argument("--ref", type=int, help="surface refinement; automatic for built-in shapes")
    parser.add_argument(
        "--points-per-wavelength",
        type=float,
        help="override points per shortest external/interior wavelength",
    )
    parser.add_argument("--sides", type=int, default=6, help="number of prism sides")
    parser.add_argument("--aspect", type=float, default=1.0, help="prism height/diameter ratio")
    parser.add_argument("--obj", help="OBJ mesh for --shape obj")
    parser.add_argument("--out", help="output directory")
    parser.add_argument("--threads", type=int, default=min(16, os.cpu_count() or 1))
    parser.add_argument("--gpu", type=int, default=0)
    parser.add_argument("--binary", help="expert override for the solver executable")
    parser.add_argument("--cxx", default="g++-12")
    parser.add_argument("--cuda-home", default="/usr")
    parser.add_argument("--no-build", action="store_true")
    parser.add_argument("--allow-memory-risk", action="store_true")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--yes", action="store_true", help="confirm strict two-grid execution")
    parser.add_argument("--json", action="store_true", help="print the effective plan as JSON")
    parser.add_argument("--solver", choices=("auto", "fmm", "pfft"), default="auto")
    parser.add_argument(
        "--single-stage",
        action="store_true",
        help="disable the automatic validated two-stage high-frequency path",
    )
    parser.add_argument("--tol", dest="tolerance", type=float)
    parser.add_argument("--digits", dest="fmm_digits", type=int)
    parser.add_argument("--quad", dest="quadrature", type=int, choices=(4, 7, 13))
    parser.add_argument("--duffy-order", type=int)
    parser.add_argument("--ntheta", type=int)
    parser.add_argument("--max-iters", dest="maximum_iterations", type=int)
    parser.add_argument("--gmres-restart", type=int)
    parser.add_argument("--max-leaf", type=int)
    parser.add_argument("--mbj-nodes", type=int)
    parser.add_argument("--mbj-overlap", type=int)
    parser.add_argument("--pfft-inner-tol", dest="pfft_inner_tolerance", type=float)
    parser.add_argument("--pfft-inner-iters", dest="pfft_inner_iterations")
    parser.add_argument("--pfft-outer-restart", type=int)
    parser.add_argument("--pfft-order", type=int)
    parser.add_argument("--pfft-correction-radius", type=float)
    parser.add_argument("--pfft-grid-safety", type=float)
    parser.add_argument(
        "--independent-polarizations",
        action="store_true",
        help=(
            "disable the verified cyclic-symmetry candidate for a regular prism"
        ),
    )
    if average:
        parser.add_argument("--alpha", "--orientations", type=int)
        parser.add_argument("--beta", type=int, help="fixed-grid beta nodes")
        parser.add_argument("--gamma", type=int, help="fixed-grid gamma nodes")
        parser.add_argument(
            "--fixed-grid",
            action="store_true",
            help="disable adaptive beta/gamma refinement",
        )
        parser.add_argument(
            "--adaptive-levels",
            nargs=2,
            type=int,
            metavar=("MIN", "MAX"),
        )
        parser.add_argument("--adaptive-m11-tol", dest="adaptive_m11_tolerance", type=float)
        parser.add_argument(
            "--adaptive-integral-tol",
            dest="adaptive_integral_tolerance",
            type=float,
        )
        parser.add_argument(
            "--adaptive-component-tol",
            dest="adaptive_component_tolerance",
            type=float,
        )
        parser.add_argument("--symmetry-order", type=int)
        parser.add_argument("--orient-warm-max-angle", type=float)
        parser.add_argument("--orient-recycle-rank", type=int)
        parser.add_argument("--orient-zero-start", action="store_true")
        parser.add_argument(
            "--orient-paired-gpu-gmres",
            action=argparse.BooleanOptionalAction,
            default=None,
        )


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="bem",
        description="Safe preset launcher for the BEM-CPP Muller solver.",
    )
    parser.add_argument("--version", action="version", version=f"bem {VERSION}")
    subparsers = parser.add_subparsers(dest="command", required=True)

    run = subparsers.add_parser("run", help="single-orientation calculation")
    add_calculation_arguments(run, average=False)
    run.set_defaults(handler=lambda args: command_calculate(args, "run"))

    average = subparsers.add_parser("average", help="Euler-angle orientation average")
    add_calculation_arguments(average, average=True)
    average.set_defaults(handler=lambda args: command_calculate(args, "average"))

    presets = subparsers.add_parser("presets", help="list quality profiles")
    presets.add_argument("--json", action="store_true")
    presets.set_defaults(handler=command_presets)

    explain = subparsers.add_parser("explain", help="show one quality profile")
    explain.add_argument(
        "quality", choices=tuple(PROFILES) + tuple(QUALITY_ALIASES)
    )
    explain.add_argument("--json", action="store_true")
    explain.set_defaults(handler=command_explain)

    resume = subparsers.add_parser("resume", help="resume a saved calculation")
    resume.add_argument("directory")
    resume.add_argument("--no-build", action="store_true")
    resume.add_argument("--allow-memory-risk", action="store_true")
    resume.add_argument("--json", action="store_true")
    resume.set_defaults(handler=command_resume)

    validate = subparsers.add_parser("validate", help="validate a result JSON")
    validate.add_argument("result")
    validate.add_argument("--reference")
    validate.add_argument("--max-normalized-l2", type=float, default=0.05)
    validate.add_argument("--max-forward-difference", type=float, default=0.05)
    validate.add_argument("--json", action="store_true")
    validate.set_defaults(handler=command_validate)
    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    try:
        return int(args.handler(args))
    except KeyboardInterrupt:
        print("\nbem: interrupted; compatible checkpoints and caches were kept", file=sys.stderr)
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
