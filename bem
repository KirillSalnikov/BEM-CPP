    print(f"  command: {shlex.join(plan['command'])}")


def plan_leaves(plan: dict[str, Any]) -> Iterable[dict[str, Any]]:
    if plan["kind"] == "strict_suite":
        yield from plan["children"]
    else:
        yield plan


def enforce_memory(plan: dict[str, Any], allow_risk: bool) -> None:
    for leaf in plan_leaves(plan):
        available = gpu_memory_gib(int(leaf["runtime"]["gpu"]))
        if available is None:
            continue
        estimated = float(leaf["estimate"]["gpu_memory_gib"])
        if estimated > 0.85 * available:
            message = (
                f"ref={leaf['inputs']['refinement']} is estimated to need "
                f"{estimated:.1f} GiB, while GPU {leaf['runtime']['gpu']} has "
                f"{available:.1f} GiB"
            )
            if not allow_risk:
                fail(message + "; choose a smaller --ref or use --allow-memory-risk")
            print(f"warning: {message}", file=sys.stderr)


def write_json_atomic(path: Path, data: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(
        json.dumps(data, indent=2, ensure_ascii=False) + "\n",
        encoding="utf-8",
    )
    temporary.replace(path)


def write_single_files(plan: dict[str, Any]) -> None:
    output = Path(plan["output_directory"])
    output.mkdir(parents=True, exist_ok=True)
    write_json_atomic(output / CONFIG_NAME, plan)
    runtime = plan["runtime"]
    script = (
        "#!/usr/bin/env bash\n"
        "set -euo pipefail\n"
        f"export OMP_NUM_THREADS={shlex.quote(str(runtime['threads']))}\n"
        f"export CUDA_VISIBLE_DEVICES={shlex.quote(str(runtime['gpu']))}\n"
    )
    for name, value in runtime.get("environment", {}).items():
        script += f"export {name}={shlex.quote(str(value))}\n"
    script += f"exec {shlex.join(plan['command'])}\n"
    command_path = output / "command.sh"
    command_path.write_text(script, encoding="utf-8")
    command_path.chmod(0o755)


def write_plan_files(plan: dict[str, Any]) -> None:
    output = Path(plan["output_directory"])
    output.mkdir(parents=True, exist_ok=True)
    write_json_atomic(output / CONFIG_NAME, plan)
    for leaf in plan_leaves(plan):
        write_single_files(leaf)


def ensure_binary(plan: dict[str, Any], no_build: bool) -> None:
    binary = Path(plan["runtime"]["binary"])
    if binary.is_file() and os.access(binary, os.X_OK):
        return
    target = plan["runtime"]["build_target"]
    if no_build or not target:
        fail(f"missing executable {binary}")
    command = [
        "make", target,
        f"CXX={plan['runtime']['cxx']}",
        f"CUDA_HOME={plan['runtime']['cuda_home']}",
        f"-j{max(1, int(plan['runtime']['threads']))}",
    ]
    print(f"Building solver: {shlex.join(command)}")
    completed = subprocess.run(command, cwd=ROOT, check=False)
    if completed.returncode != 0:
        fail(f"build failed with code {completed.returncode}", 1)


def residuals(data: dict[str, Any]) -> list[float]:
    values: list[float] = []
    if isinstance(data.get("iterations"), dict):
        value = data["iterations"].get("maximum_residual")
        if value is not None:
            values.append(float(value))
    if isinstance(data.get("mbj"), dict):
        value = data["mbj"].get("fmm_residual")
        if value is not None:
            values.append(float(value))
    if isinstance(data.get("physical"), dict):
        value = data["physical"].get("parallel_fmm_residual")
        if value is not None:
            values.append(float(value))
    return values


def mueller_data(data: dict[str, Any]) -> tuple[list[float], list[Any]] | None:
    if isinstance(data.get("physical"), dict):
        theta = data["physical"].get("theta_degrees")
        mueller = data["physical"].get("mueller")
    else:
        theta = data.get("theta_degrees")
        mueller = data.get("mueller")
    if not isinstance(theta, list) or not isinstance(mueller, list):
        return None
    return theta, mueller


def flatten(values: Any) -> list[float]:
    if isinstance(values, list):
        result: list[float] = []
        for value in values:
            result.extend(flatten(value))
        return result
    return [float(values)]


def interpolate_series(
    source_x: list[float], source_y: list[float], target_x: list[float]
) -> list[float]:
    if len(source_x) != len(source_y) or len(source_x) < 2:
        fail("Mueller comparison requires at least two matching angular samples")
    if any(b <= a for a, b in zip(source_x, source_x[1:])):
        fail("Mueller comparison angles must be strictly increasing")
    if not target_x or any(b <= a for a, b in zip(target_x, target_x[1:])):
        fail("target Mueller comparison angles must be strictly increasing")
    if target_x[0] < source_x[0] or target_x[-1] > source_x[-1]:
        fail("Mueller comparison angle ranges do not overlap completely")
    result: list[float] = []
    lower = 0
    for target in target_x:
        while lower + 1 < len(source_x) and source_x[lower + 1] < target:
            lower += 1
        if target == source_x[lower]:
            result.append(source_y[lower])
            continue
        upper = min(lower + 1, len(source_x) - 1)
        if target == source_x[upper]:
            result.append(source_y[upper])
            continue
        fraction = (target - source_x[lower]) / (source_x[upper] - source_x[lower])
        result.append(source_y[lower] + fraction * (source_y[upper] - source_y[lower]))
    return result


def resample_mueller(
    source_theta: list[float], source_mueller: list[Any], target_theta: list[float]
) -> list[Any]:
    if len(source_mueller) != 4 or any(len(row) != 4 for row in source_mueller):
        fail("Mueller comparison requires a 4x4 matrix layout")
    return [
        [
            interpolate_series(source_theta, [float(value) for value in values], target_theta)
            for values in row
        ]
        for row in source_mueller
    ]


def inspect_result(path: Path) -> tuple[dict[str, Any], bool]:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        return {"path": str(path), "errors": [str(error)], "warnings": []}, False

    errors: list[str] = []
    warnings: list[str] = []
    tolerance = float(data.get("tolerance", 0.0))
    found_residuals = residuals(data)
    if not found_residuals:
        errors.append("no true full-operator residual found")
    elif tolerance <= 0.0:
        errors.append("missing positive tolerance")
    elif max(found_residuals) > 2.0 * tolerance:
        errors.append(
            f"maximum residual {max(found_residuals):.3e} exceeds 2*tolerance"
        )

    physical = mueller_data(data)
    if physical is None:
        errors.append("Mueller matrix is missing")
    else:
        theta, mueller = physical
        flat = flatten(mueller)
        if not theta or not flat:
            errors.append("Mueller matrix is empty")
        elif not all(math.isfinite(value) for value in flat):
            errors.append("Mueller matrix contains non-finite values")

    if data.get("software_version") is None:
        warnings.append("software_version is absent (pre-release result)")
    adaptive = data.get("adaptive")
    if isinstance(adaptive, dict) and adaptive.get("enabled"):
        if not adaptive.get("converged"):
            errors.append(
                "adaptive orientation averaging reached its maximum level "
                "without satisfying convergence tolerances"
            )
    if data.get("hdiv_conforming") and not data.get("sharp_edge_formulation_validated"):
        warnings.append("sharp-edge H(div) result still requires independent validation")
    report = {
        "path": str(path),
        "software_version": data.get("software_version"),
        "solver": data.get("solver"),
        "tolerance": tolerance,
        "maximum_residual": max(found_residuals) if found_residuals else None,
        "errors": errors,
        "warnings": warnings,
    }
    return report, not errors


def compare_results(first_path: Path, second_path: Path) -> dict[str, Any]:
    first = json.loads(first_path.read_text(encoding="utf-8"))
    second = json.loads(second_path.read_text(encoding="utf-8"))
    first_physical = mueller_data(first)
    second_physical = mueller_data(second)
    if first_physical is None or second_physical is None:
        fail("both comparison results must contain Mueller matrices")
    first_theta, first_mueller = first_physical
    second_theta, second_mueller = second_physical
    interpolated = first_theta != second_theta
    if interpolated:
        second_mueller = resample_mueller(second_theta, second_mueller, first_theta)
    a = flatten(first_mueller)
    b = flatten(second_mueller)
    if len(a) != len(b) or not a:
        fail("comparison results use incompatible Mueller layouts")
    a0 = float(first_mueller[0][0][0])
    b0 = float(second_mueller[0][0][0])
    if a0 == 0.0 or b0 == 0.0:
        fail("M11(0) is zero in a comparison result")
    an = [value / a0 for value in a]
    bn = [value / b0 for value in b]
    raw_den = math.sqrt(sum(value * value for value in b)) or 1.0
    norm_den = math.sqrt(sum(value * value for value in bn)) or 1.0
    return {
        "comparison_angles": len(first_theta),
        "reference_interpolated": interpolated,
        "raw_relative_l2": math.sqrt(sum((x - y) ** 2 for x, y in zip(a, b))) / raw_den,
        "normalized_relative_l2": math.sqrt(
            sum((x - y) ** 2 for x, y in zip(an, bn))
        ) / norm_den,
        "maximum_normalized_absolute_difference": max(
            abs(x - y) for x, y in zip(an, bn)
        ),
        "forward_m11_ratio": a0 / b0,
        "forward_relative_difference": abs(a0 / b0 - 1.0),
    }


def result_is_complete(plan: dict[str, Any]) -> bool:
    path = Path(plan["result_path"])
    return path.is_file() and inspect_result(path)[1]


def run_process(plan: dict[str, Any], no_build: bool, resume: bool) -> None:
    if resume and result_is_complete(plan):
        print(f"Already complete: {plan['result_path']}")
        return
    started = time.monotonic()
    ensure_binary(plan, no_build)
    output = Path(plan["output_directory"])
    environment = os.environ.copy()
    environment["OMP_NUM_THREADS"] = str(plan["runtime"]["threads"])
    environment["CUDA_VISIBLE_DEVICES"] = str(plan["runtime"]["gpu"])
    environment.update(
        {
            str(name): str(value)
            for name, value in plan["runtime"].get("environment", {}).items()
        }
    )
    log_path = output / "run.log"
    print(f"Running: {shlex.join(plan['command'])}")
    sys.stdout.flush()
    with log_path.open("a", encoding="utf-8") as log:
        process = subprocess.Popen(
            plan["command"],
            cwd=ROOT,
            env=environment,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            bufsize=1,
        )
        assert process.stdout is not None
        for line in process.stdout:
            print(line, end="")
            log.write(line)
            log.flush()
        return_code = process.wait()
    if return_code != 0:
        fail(
            f"solver exited with code {return_code}; see {log_path}",
            return_code if return_code > 0 else 1,
        )
    report, valid = inspect_result(Path(plan["result_path"]))
    report["wall_time_s"] = time.monotonic() - started
    write_json_atomic(output / "validation.json", report)
    if not valid:
        fail(f"result validation failed; see {output / 'validation.json'}", 1)
    print(f"Finished: {plan['result_path']}")
    print(f"Validation: PASS ({output / 'validation.json'})")


def execute_plan(plan: dict[str, Any], no_build: bool, resume: bool) -> None:
    started = time.monotonic()
    write_plan_files(plan)
    if plan["kind"] != "strict_suite":
        run_process(plan, no_build, resume)
        return
    for child in plan["children"]:
        run_process(child, no_build, resume)
    comparison = compare_results(
        Path(plan["comparison"]["coarse"]),
        Path(plan["comparison"]["fine"]),
    )
    comparison["passes"] = (
        comparison["normalized_relative_l2"] <=
        plan["comparison"]["maximum_normalized_relative_l2"]
        and comparison["forward_relative_difference"] <=
        plan["comparison"]["maximum_forward_relative_difference"]
    )
    comparison["suite_wall_time_s"] = time.monotonic() - started
    write_json_atomic(Path(plan["output_directory"]) / "mesh_convergence.json", comparison)
    if not comparison["passes"]:
        fail("strict two-mesh convergence gate failed", 1)
    print("Strict two-mesh convergence gate: passed")


def command_calculate(args: argparse.Namespace, kind: str) -> int:
    plan = create_plan(args, kind)
    print_plan(plan, args.json)
    sys.stdout.flush()
    enforce_memory(plan, args.allow_memory_risk)
    if args.dry_run:
        return 0
    output = Path(plan["output_directory"])
    if output.exists() and any(output.iterdir()):
        fail(f"output directory is not empty: {output}; use 'bem resume {output}'")
    if plan["kind"] == "strict_suite" and not args.yes:
        if not sys.stdin.isatty():
            fail("strict mode requires --yes in a non-interactive session")
        answer = input("Run both FP64 refinements? [y/N] ").strip().lower()
        if answer not in {"y", "yes"}:
            print("Cancelled.")
            return 0
    execute_plan(plan, args.no_build, resume=False)
    return 0


def command_resume(args: argparse.Namespace) -> int:
    directory = Path(args.directory).expanduser().resolve()
    config = directory / CONFIG_NAME
    if not config.is_file():
        fail(f"missing {config}")
    plan = json.loads(config.read_text(encoding="utf-8"))
    for leaf in plan_leaves(plan):
        if leaf.get("kind") == "average":
            leaf.setdefault("runtime", {}).setdefault("environment", {})[
                "BEM_MULLER_GPU_ASSEMBLY"
            ] = "1"
    print_plan(plan, args.json)
    enforce_memory(plan, args.allow_memory_risk)
    execute_plan(plan, args.no_build, resume=True)
    return 0


def command_validate(args: argparse.Namespace) -> int:
    path = Path(args.result).expanduser().resolve()
    report, valid = inspect_result(path)
    if args.reference:
        reference = Path(args.reference).expanduser().resolve()
        comparison = compare_results(path, reference)
        comparison["passes"] = (
            comparison["normalized_relative_l2"] <= args.max_normalized_l2
            and comparison["forward_relative_difference"] <= args.max_forward_difference
        )
        report["comparison"] = comparison
        valid = valid and comparison["passes"]
    if args.json:
        print(json.dumps(report, indent=2, ensure_ascii=False))
    else:
        print(f"Result: {'PASS' if valid else 'FAIL'}")
        print(f"  solver: {report.get('solver')}")
        print(f"  maximum residual: {report.get('maximum_residual')}")
        for warning in report["warnings"]:
            print(f"  warning: {warning}")
        for error in report["errors"]:
            print(f"  error: {error}")
        if "comparison" in report:
            print(
                "  normalized L2 difference: "
                f"{report['comparison']['normalized_relative_l2']:.3e}"
            )
            print(
                "  forward M11 difference: "
                f"{report['comparison']['forward_relative_difference']:.3e}"
            )
            if report["comparison"]["reference_interpolated"]:
                print("  reference Mueller matrix: linearly interpolated by angle")
    return 0 if valid else 1


def command_presets(args: argparse.Namespace) -> int:
    data = {name: asdict(profile) for name, profile in PROFILES.items()}
    if args.json:
        print(json.dumps(data, indent=2, ensure_ascii=False))
    else:
