def fail(message: str, code: int = 2) -> NoReturn:
    print(f"bem: {message}", file=sys.stderr)
    raise SystemExit(code)


def number_slug(value: float) -> str:
    return f"{value:g}".replace("-", "m").replace(".", "p")


def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def default_output(args: argparse.Namespace) -> Path:
    stamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    name = (
        f"{args.shape}_ka{number_slug(args.ka)}_"
        f"m{number_slug(args.ri)}_{args.quality}_{stamp}"
    )
    return ROOT / "runs" / name


def base_edge_scale(args: argparse.Namespace) -> float:
    if args.shape == "prism":
        return max(2.0 * math.sin(math.pi / args.sides), args.aspect)
    if args.shape == "cube":
        return 1.0
    return 1.0


def shortest_wavelength_factor(args: argparse.Namespace) -> float:
    return max(1.0, abs(args.ri))


def automatic_refinement(args: argparse.Namespace, profile: Profile) -> int:
    if args.ref is not None:
        if args.ref < 0:
            fail("--ref must be non-negative")
        return args.ref
    if args.shape == "obj":
        fail("automatic refinement is unsafe for OBJ meshes; specify --ref")
    points_per_wavelength = (
        args.points_per_wavelength
        if args.points_per_wavelength is not None
        else profile.points_per_wavelength
    )
    if points_per_wavelength <= 0.0:
        fail("--points-per-wavelength must be positive")
    required = (
        points_per_wavelength
        * args.ka
        * base_edge_scale(args)
        * shortest_wavelength_factor(args)
        / (4.0 * math.pi)
    )
    return max(profile.minimum_refinement, int(math.ceil(math.log2(max(1.0, required)))))


def obj_triangle_count(path: Path) -> int:
    try:
        with path.open(encoding="utf-8", errors="ignore") as stream:
            return sum(1 for line in stream if line.startswith("f "))
    except OSError as error:
        fail(f"cannot read OBJ mesh {path}: {error}")


def estimate_dofs(args: argparse.Namespace, refinement: int) -> int:
    scale = 4 ** refinement
    if args.shape == "sphere":
        return 160 * scale + 8
    if args.shape == "obj":
        triangles = obj_triangle_count(Path(args.obj))
        return max(1, 6 * triangles * scale)
    if args.shape == "cube":
        return 72 * scale
    sides = args.sides
    segment_count = 1 << refinement
    circumradius = (
        1.0 / (2.0 * math.cos(math.pi / sides))
        if sides % 2 == 0
        else 1.0 / (1.0 + math.cos(math.pi / sides))
    )
    side_length = 2.0 * circumradius * math.sin(math.pi / sides)
    height_segments = max(
        segment_count,
        int(math.ceil(args.aspect * segment_count / side_length)),
    )
    triangles = (
        2 * sides * segment_count * (height_segments + segment_count)
    )
    return 6 * triangles


def estimate_memory_gib(profile: Profile, dofs: int, pfft_fgmres: bool) -> float:
    if profile.name == "preview":
        # Measured ka=80/ref=6 peak with one interior FP32 phase table.
        return 22.7
    # Conservative empirical envelope from the 24 GiB release-machine runs.
    if profile.sequential_currents and pfft_fgmres:
        # Sequential electric/magnetic FMM actions avoid both mixed and
        # strict paired-current workspaces.
        return 1.25 + dofs * (14 * 1024) / (1024.0 ** 3)
    if profile.compact_caches and pfft_fgmres:
        # The phase and flattened near-source caches accounted for about
        # 5.6 GiB of an 18.2 GiB ka=60/ref=6 measurement.
        return 1.5 + dofs * (18 * 1024) / (1024.0 ** 3)
    bytes_per_dof = 28 * 1024 if pfft_fgmres else (
        26 * 1024 if not profile.mixed_precision else 20 * 1024
    )
    fixed_gib = 2.0 if pfft_fgmres else 1.0
    return fixed_gib + dofs * bytes_per_dof / (1024.0 ** 3)


def gpu_memory_status_gib(index: int) -> tuple[float, float] | None:
    executable = shutil.which("nvidia-smi")
    if not executable:
        return None
    process = subprocess.run(
        [
            executable,
            f"--id={index}",
            "--query-gpu=memory.total,memory.free",
            "--format=csv,noheader,nounits",
        ],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if process.returncode != 0:
        return None
    try:
        values = process.stdout.splitlines()[0].split(",")
        return float(values[0].strip()) / 1024.0, float(values[1].strip()) / 1024.0
    except (IndexError, ValueError):
        return None


def binary_for(args: argparse.Namespace, profile: Profile) -> tuple[Path, str]:
    if args.binary:
        return Path(args.binary).expanduser().resolve(), ""
    if profile.mixed_precision:
        return ROOT / "bin" / "muller_nodal_fmm_demo_fp32", "muller-fp32"
    return ROOT / "bin" / "muller_nodal_fmm_demo", "bin/muller_nodal_fmm_demo"


def shape_arguments(args: argparse.Namespace) -> list[str]:
    if args.shape == "prism":
        if args.sides < 3:
            fail("--sides must be at least 3")
        if args.aspect <= 0.0:
            fail("--aspect must be positive")
        return ["--shape", "prism", "--sides", str(args.sides), "--aspect", str(args.aspect)]
    if args.shape == "cube":
        return ["--shape", "cube"]
    if args.shape == "sphere":
        return ["--shape", "sphere"]
    obj = Path(args.obj).expanduser().resolve() if args.obj else None
    if not obj or not obj.is_file():
        fail("--shape obj requires an existing --obj FILE")
    return ["--shape", "obj", "--obj", str(obj)]


def operator_cache_directory(
    args: argparse.Namespace,
    refinement: int,
    edge_mode: str,
    quadrature: int,
    duffy_order: int,
) -> Path:
    """Return a shared cache path for one physical discretized operator."""
    shape: dict[str, Any] = {"kind": args.shape}
    if args.shape == "prism":
        shape.update({"sides": args.sides, "aspect": float(args.aspect).hex()})
    elif args.shape == "obj":
        obj = Path(args.obj).expanduser().resolve()
        digest = hashlib.sha256()
        with obj.open("rb") as source:
            for chunk in iter(lambda: source.read(1024 * 1024), b""):
                digest.update(chunk)
        shape["content_sha256"] = digest.hexdigest()

    identity = {
        "cache_schema": 2,
        "formulation": "muller_p2",
        "shape": shape,
        "refinement": refinement,
        "ka": float(args.ka).hex(),
        "relative_refractive_index": float(args.ri).hex(),
        "edge_mode": edge_mode,
        "quadrature": quadrature,
        "duffy_order": duffy_order,
    }
    encoded = json.dumps(
        identity, sort_keys=True, separators=(",", ":")
    ).encode("ascii")
    key = hashlib.sha256(encoded).hexdigest()
    root = Path(
        os.environ.get("BEM_CACHE_DIR", Path.home() / ".cache" / "bem-cpp")
    ).expanduser().resolve()
    return root / "operators" / "v2" / key


def use_pfft_fgmres(args: argparse.Namespace, profile: Profile) -> bool:
    if args.solver == "fmm":
        return False
    if args.solver == "pfft":
        return True
    return profile.solver_policy == "adaptive_pfft" and args.ka >= 10.0


def solver_label(value: str) -> str:
    return "FMM+pFFT-FGMRES" if value == "fmm_pfft_fgmres" else "FMM+MBJ"


def solver_arguments(
    pfft_fgmres: bool,
    mbj_nodes: int,
    mbj_overlap: int,
    pfft_inner_tolerance: float,
    pfft_inner_iterations: str,
    pfft_outer_restart: int,
    pfft_order: int,
    pfft_correction_radius: float,
    pfft_grid_safety: float,
) -> list[str]:
    arguments = [
        "--mbj-only",
        "--mbj-nodes", str(mbj_nodes),
        "--mbj-overlap", str(mbj_overlap),
    ]
    if pfft_fgmres:
        arguments += [
            "--pfft-fgmres",
            "--pfft-inner-tol", f"{pfft_inner_tolerance:g}",
            "--pfft-inner-iters", pfft_inner_iterations,
            "--pfft-outer-restart", str(pfft_outer_restart),
            "--pfft-order", str(pfft_order),
            "--pfft-correction-radius", f"{pfft_correction_radius:g}",
            "--pfft-grid-safety", f"{pfft_grid_safety:g}",
        ]
    return arguments


def effective_max_leaf(args: argparse.Namespace, profile: Profile) -> int:
    if args.max_leaf is not None:
        return args.max_leaf
    # Shallow trees avoid unstable mixed-precision translations on small cases.
    if profile.mixed_precision and args.ka < 5.0:
        return 128
    return profile.max_leaf


def selected(args: argparse.Namespace, name: str, default: Any) -> Any:
    value = getattr(args, name, None)
    return default if value is None else value


def default_maximum_iterations(args: argparse.Namespace, profile: Profile) -> int:
    if profile.name == "quick" and abs(args.ri) >= 2.5:
        return max(profile.maximum_iterations, 400)
    return profile.maximum_iterations


def default_mbj_nodes(args: argparse.Namespace, profile: Profile) -> int:
    if profile.name in {"fast", "standard", "memory"} and abs(args.ri) >= 2.5:
        return 100
    return 50


def default_pfft_inner_tolerance(dofs: int) -> float:
    return 8.0e-2 if dofs >= 500_000 else 4.0e-2


def default_orientation_maximum_level(
    args: argparse.Namespace, profile: Profile,
) -> int:
    if abs(args.ri) >= 2.0:
        if profile.name == "quick":
            return max(profile.orientation_maximum_level, 4)
        if profile.name in {"standard", "memory"}:
            return max(profile.orientation_maximum_level, 5)
    return profile.orientation_maximum_level


def orientation_parameters(
    args: argparse.Namespace,
    profile: Profile,
    output: Path,
    pfft_fgmres: bool,
) -> tuple[list[str], dict[str, Any]]:
    adaptive_override = any(
        value is not None
        for value in (
            args.adaptive_levels,
            args.adaptive_m11_tolerance,
            args.adaptive_integral_tolerance,
            args.adaptive_component_tolerance,
        )
    )
    fixed_requested = args.fixed_grid or args.beta is not None or args.gamma is not None
    if adaptive_override and fixed_requested:
        fail("adaptive averaging controls cannot be combined with --fixed-grid/--beta/--gamma")
    adaptive = adaptive_override or not fixed_requested

    alpha = selected(args, "alpha", 8)
    if alpha < 1:
        fail("--alpha must be positive")
    symmetry = args.symmetry_order
    if symmetry is None:
        symmetry = args.sides if args.shape == "prism" else (
            4 if args.shape == "cube" else 1
        )
    if symmetry < 1:
        fail("--symmetry-order must be positive")

    warm_angle = selected(args, "orient_warm_max_angle", 25.0)
    recycle_rank = selected(
        args, "orient_recycle_rank", profile.orientation_recycle_rank
    )
    if warm_angle <= 0.0:
        fail("--orient-warm-max-angle must be positive")
    if recycle_rank < 0 or recycle_rank > 128:
        fail("--orient-recycle-rank must be in [0,128]")

    arguments: list[str]
    details: dict[str, Any]
    if adaptive:
        levels = args.adaptive_levels or (
            profile.orientation_minimum_level,
            default_orientation_maximum_level(args, profile),
        )
        minimum_level, maximum_level = levels
        if minimum_level < 1 or maximum_level <= minimum_level or maximum_level > 15:
            fail("--adaptive-levels requires 1 <= MIN < MAX <= 15")
        m11_tolerance = selected(
            args, "adaptive_m11_tolerance", profile.orientation_m11_tolerance
        )
        integral_tolerance = selected(
            args,
            "adaptive_integral_tolerance",
            profile.orientation_integral_tolerance,
        )
        component_tolerance = selected(
            args,
            "adaptive_component_tolerance",
            profile.orientation_component_tolerance,
        )
        if min(m11_tolerance, integral_tolerance, component_tolerance) < 0.0:
            fail("adaptive averaging tolerances must be non-negative")
        beta_nodes = (1 << maximum_level) + 1
        gamma_nodes = 1 << maximum_level
        maximum_base_orientations = beta_nodes * gamma_nodes
        parts = output / "orientation_parts"
        arguments = [
            "--orient-average", str(alpha), str(beta_nodes), str(gamma_nodes),
            "--orient-adaptive", str(minimum_level), str(maximum_level),
            "--orient-adaptive-m11-tol", f"{m11_tolerance:g}",
            "--orient-adaptive-integral-tol", f"{integral_tolerance:g}",
            "--orient-adaptive-component-tol", f"{component_tolerance:g}",
            "--orient-parts-dir", str(parts),
        ]
        dihedral_symmetry = (
            args.shape in ("cube", "prism") and alpha % 2 == 0
        )
        if dihedral_symmetry:
            arguments.append("--orient-dihedral-symmetry")
        maximum_solved_base_orientations = (
            (maximum_base_orientations + 2) // 2
            if dihedral_symmetry else maximum_base_orientations
        )
        details = {
            "mode": "adaptive",
            "alpha": alpha,
            "minimum_level": minimum_level,
            "maximum_level": maximum_level,
            "maximum_beta_nodes": beta_nodes,
            "maximum_gamma_nodes": gamma_nodes,
            "maximum_base_orientations": maximum_base_orientations,
            "maximum_solved_base_orientations": (
                maximum_solved_base_orientations
            ),
            "m11_tolerance": m11_tolerance,
            "integral_tolerance": integral_tolerance,
            "component_tolerance": component_tolerance,
            "parts_directory": str(parts),
            "dihedral_symmetry_reuse": dihedral_symmetry,
        }
    else:
        beta = selected(args, "beta", 8)
        gamma = selected(args, "gamma", 4)
        if beta < 1 or gamma < 1:
            fail("--beta and --gamma must be positive")
        arguments = ["--orient-average", str(alpha), str(beta), str(gamma)]
        details = {
            "mode": "fixed",
            "alpha": alpha,
            "beta": beta,
            "gamma": gamma,
            "base_orientations": beta * gamma,
            "dihedral_symmetry_reuse": False,
        }

    arguments += [
        "--orient-symmetry-order", str(symmetry),
        "--orient-warm-max-angle", f"{warm_angle:g}",
        "--orient-recycle-rank", str(recycle_rank),
    ]
    if args.orient_zero_start:
        arguments.append("--orient-zero-start")
    paired = selected(args, "orient_paired_gpu_gmres", not pfft_fgmres)
    if pfft_fgmres and paired:
        fail("paired GPU GMRES is incompatible with pFFT-FGMRES averaging")
    arguments.append(
        "--orient-paired-gpu-gmres"
        if paired else "--no-orient-paired-gpu-gmres"
    )
    details.update(
        {
            "symmetry_order": symmetry,
            "warm_start": not args.orient_zero_start,
            "warm_start_max_angle_degrees": warm_angle,
            "recycle_rank": recycle_rank,
            "paired_gpu_gmres": paired,
        }
    )
    return arguments, details


def make_single_plan(
    args: argparse.Namespace,
    profile: Profile,
    output: Path,
    refinement: int,
    kind: str,
) -> dict[str, Any]:
    output = output.resolve()
    binary, build_target = binary_for(args, profile)
    edge_mode = "smooth" if args.shape == "sphere" else "hdiv"
    max_leaf = effective_max_leaf(args, profile)
    pfft_fgmres = use_pfft_fgmres(args, profile)
    tolerance = selected(args, "tolerance", profile.tolerance)
    quadrature = selected(args, "quadrature", profile.quadrature)
    duffy_order = selected(args, "duffy_order", profile.duffy_order)
    fmm_digits = selected(args, "fmm_digits", profile.fmm_digits)
    maximum_iterations = selected(
        args, "maximum_iterations", default_maximum_iterations(args, profile)
    )
    gmres_restart = selected(args, "gmres_restart", profile.gmres_restart)
    ntheta = selected(args, "ntheta", profile.ntheta)
    mbj_nodes = selected(args, "mbj_nodes", default_mbj_nodes(args, profile))
    mbj_overlap = selected(args, "mbj_overlap", 0)
    dofs = estimate_dofs(args, refinement)
    pfft_inner_tolerance = selected(
        args,
        "pfft_inner_tolerance",
        0.12 if profile.name == "preview" else default_pfft_inner_tolerance(dofs),
    )
    pfft_inner_iterations = selected(args, "pfft_inner_iterations", "auto")
    pfft_outer_restart = selected(
        args, "pfft_outer_restart", 3 if profile.name == "preview" else 40
    )
    pfft_order = selected(args, "pfft_order", 2)
    pfft_correction_radius = selected(args, "pfft_correction_radius", 0.0)
    pfft_grid_safety = selected(args, "pfft_grid_safety", 1.0)
    points_per_wavelength = selected(
        args, "points_per_wavelength", profile.points_per_wavelength
    )
    exterior_points_per_wavelength = None
    interior_points_per_wavelength = None
    shortest_points_per_wavelength = None
    if args.shape != "obj":
        exterior_points_per_wavelength = (
            4.0 * math.pi * (1 << refinement)
            / (args.ka * base_edge_scale(args))
        )
        interior_points_per_wavelength = exterior_points_per_wavelength / abs(args.ri)
        shortest_points_per_wavelength = (
            exterior_points_per_wavelength / shortest_wavelength_factor(args)
        )
    result = output / "result.json"
    cache_directory = operator_cache_directory(
        args, refinement, edge_mode, quadrature, duffy_order
    )
    command = [str(binary)]
    command += shape_arguments(args)
    command += [
        "--ref", str(refinement),
        "--ka", f"{args.ka:g}",
        "--ri", f"{args.ri:g}",
        "--edge-mode", edge_mode,
        "--quad", str(quadrature),
        "--duffy-order", str(duffy_order),
        "--digits", str(fmm_digits),
        "--max-leaf", str(max_leaf),
        "--fmm-near-radius", "3",
        "--tol", f"{tolerance:.1e}",
        "--max-iters", str(maximum_iterations),
        "--gmres-restart", str(gmres_restart),
    ]
    command += solver_arguments(
        pfft_fgmres,
        mbj_nodes,
        mbj_overlap,
        pfft_inner_tolerance,
        str(pfft_inner_iterations),
        pfft_outer_restart,
        pfft_order,
        pfft_correction_radius,
        pfft_grid_safety,
    )
    if profile.name == "preview":
        command += ["--trust-final-projected-residual"]
    command += [
        "--fmm-near-fp32" if profile.mixed_precision else "--fmm-near-fp64",
        "--near-correction-cache", str(cache_directory / "operator.near"),
        "--mbj-cache", str(
            cache_directory / f"mbj_n{mbj_nodes}_o{mbj_overlap}.cache"
        ),
        "--physical-check",
        "--ntheta", str(ntheta),
        "--no-dense-validation",
        "--iteration-log", str(output / "iterations.csv"),
    ]
    if profile.name == "preview":
        command += ["--no-checkpoint"]
    else:
        command += ["--checkpoint", str(output / "checkpoint")]

    prism_polarization_symmetry_candidate = (
        kind == "run"
        and args.shape == "prism"
        and profile.name != "strict"
        and not args.independent_polarizations
    )
    if prism_polarization_symmetry_candidate:
        command += [
            "--cyclic-polarization",
            "--cyclic-exact-geometry",
        ]

    orientation: dict[str, Any] | None = None
    if kind == "average":
        orientation_arguments, orientation = orientation_parameters(
            args, profile, output, pfft_fgmres
        )
        orientation.update({
            "operator_setup_reused": True,
            "operator_setup_count": 1,
            "resume_granularity": "completed_base_orientation",
        })
        command += orientation_arguments

    command += ["--out", str(result)]
    memory = estimate_memory_gib(profile, dofs, pfft_fgmres)
    strict_residual_refinement = (
        profile.mixed_precision and tolerance <= 1.0e-5
    )
    safe_sequential_currents = (
        profile.sequential_currents
        or (kind == "run" and strict_residual_refinement)
    )
    runtime_environment: dict[str, str] = {}
    if kind == "average":
        runtime_environment["BEM_MULLER_GPU_ASSEMBLY"] = "1"
    if strict_residual_refinement:
        runtime_environment["BEM_MIXED_ITERATIVE_REFINEMENT"] = "1"
        # A mixed Krylov operator is corrected against an FP64 residual after
        # each restart. Sequential current actions avoid the inaccurate fused
        # current kernel while retaining the fast FP32 L2P stage.
        runtime_environment["BEM_FMM_L2P_FP32"] = (
            "1" if kind == "run" and safe_sequential_currents else "0"
        )
    if profile.compact_caches:
        runtime_environment["BEM_FMM_PHASE_CACHE"] = "0"
        runtime_environment["BEM_FMM_FLAT_NEAR_SOURCES"] = "0"
    if profile.name == "preview":
        runtime_environment.update({
            "BEM_MIXED_ITERATIVE_REFINEMENT": "0",
            "BEM_FMM_L2P_FP32": "1",
            "BEM_FMM_PHASE_CACHE": "1",
            "BEM_FMM_PHASE_CACHE_RESERVE_MB": "512",
            "BEM_FMM_L2P_WARP_PER_TARGET": "1",
            "BEM_FMM_L2P_PHASE_CACHE_FP16": "1",
            "BEM_FMM_L2P_PHASE_CACHE_FP16_MB": "1024",
            "BEM_FMM_FLAT_NEAR_SOURCES": "0",
            "BEM_FMM_INTERIOR_FIRST": "1",
        })
    elif profile.name == "quick":
        runtime_environment.update({
            "BEM_FMM_L2P_PHASE_CACHE_FP16": "1",
            "BEM_FMM_L2P_PHASE_CACHE_FP16_MB": "1024",
        })
    if strict_residual_refinement and dofs >= 700_000 and args.ka >= 100.0:
        runtime_environment["BEM_FMM_STRICT_PAIR_WORKSPACE"] = "0"
    runtime_environment["BEM_FMM_PAIR_CURRENTS"] = (
        "0" if safe_sequential_currents else "1"
    )
    return {
        "schema_version": 1,
        "wrapper_version": VERSION,
        "created_at_utc": utc_now(),
        "kind": kind,
        "quality": profile.name,
        "profile": asdict(profile),
        "effective_parameters": {
            "max_leaf": max_leaf,
            "near_precision": "fp32" if profile.mixed_precision else "fp64",
            "solver": "fmm_pfft_fgmres" if pfft_fgmres else "fmm_mbj",
            "tolerance": tolerance,
            "quadrature": quadrature,
            "duffy_order": duffy_order,
            "fmm_digits": fmm_digits,
            "maximum_iterations": maximum_iterations,
            "gmres_restart": gmres_restart,
            "ntheta": ntheta,
            "mbj_nodes": mbj_nodes,
            "mbj_overlap": mbj_overlap,
            "pfft_inner_tolerance": pfft_inner_tolerance,
            "pfft_inner_tolerance_selection": (
                "explicit"
                if args.pfft_inner_tolerance is not None
                else "automatic_by_system_size"
            ),
            "pfft_inner_iterations": pfft_inner_iterations,
            "pfft_outer_restart": pfft_outer_restart,
            "pfft_order": pfft_order,
            "pfft_correction_radius": pfft_correction_radius,
            "pfft_grid_safety": pfft_grid_safety,
            "strict_residual_refinement": strict_residual_refinement,
            "final_residual_verification": (
                "projected_residual_only"
                if profile.name == "preview"
                else "operator_residual"
            ),
            "krylov_operator_policy": (
                "mixed_fmm_with_fp64_restart_residual"
                if strict_residual_refinement
                else "profile_operator"
            ),
            "polarization_mode": (
                "verified_prism_symmetry_with_correction"
                if prism_polarization_symmetry_candidate
                else "independent"
            ),
            "l2p_precision": (
                "fp32_krylov_fp64_restart_residual"
                if strict_residual_refinement and kind == "run"
                and safe_sequential_currents
                else ("fp64" if strict_residual_refinement
                else ("fp32" if profile.mixed_precision else "fp64")
                )
            ),
            "memory_policy": (
                "sequential_currents_and_recompute_caches"
                if safe_sequential_currents else (
                    "recompute_phases_and_direct_near_lists"
                    if profile.compact_caches else "performance_caches"
                )
            ),
            "automatic_high_contrast_adjustments": {
                "extended_iterations": (
                    args.maximum_iterations is None
                    and maximum_iterations > profile.maximum_iterations
                ),
                "extended_angular_levels": (
                    kind == "average"
                    and args.adaptive_levels is None
                    and profile.name in {"quick", "standard", "memory"}
                    and abs(args.ri) >= 2.0
                ),
                "larger_mbj_blocks": (
                    args.mbj_nodes is None
                    and mbj_nodes > 50
                ),
            },
            "orientation": orientation,
        },
        "inputs": {
            "shape": args.shape,
            "ka": args.ka,
            "relative_refractive_index": args.ri,
            "refinement": refinement,
            "refinement_selection": "explicit" if args.ref is not None else "automatic",
            "target_points_per_exterior_wavelength": (
                points_per_wavelength * shortest_wavelength_factor(args)
            ),
            "target_points_per_shortest_wavelength": points_per_wavelength,
            "estimated_points_per_exterior_wavelength": exterior_points_per_wavelength,
            "estimated_points_per_interior_wavelength": interior_points_per_wavelength,
            "estimated_points_per_shortest_wavelength": shortest_points_per_wavelength,
            "shortest_wavelength_refractive_factor": shortest_wavelength_factor(args),
            "sides": args.sides if args.shape == "prism" else None,
            "aspect": args.aspect if args.shape == "prism" else None,
            "obj": str(Path(args.obj).expanduser().resolve()) if args.obj else None,
        },
        "estimate": {
            "system_dofs": dofs,
            "gpu_memory_gib": round(memory, 2),
            "checkpoint_disk_gib": round(
                dofs * (32 if kind == "average" else 16) /
                (1024.0 ** 3),
                3,
            ),
            "note": "conservative estimate; setup-only reports actual allocation",
        },
        "runtime": {
            "binary": str(binary),
            "build_target": build_target,
            "threads": args.threads,
            "gpu": args.gpu,
            "cxx": args.cxx,
            "cuda_home": args.cuda_home,
            "environment": runtime_environment,
        },
        "output_directory": str(output),
        "cache_directory": str(cache_directory),
        "cache_policy": "shared_content_addressed_operator_v2",
        "result_path": str(result),
        "command": command,
    }


def replace_command_option(
    command: list[str], option: str, value: str,
) -> None:
    index = command.index(option)
    command[index + 1] = value


def remove_command_option(
    command: list[str], option: str, takes_value: bool = False,
) -> None:
    if option not in command:
        return
    index = command.index(option)
    del command[index:index + (2 if takes_value else 1)]


def automatic_banded_settings(
    args: argparse.Namespace,
    profile: Profile,
    refinement: int,
    dofs: int,
) -> dict[str, Any]:
    """Choose a conservative banded-FMM hierarchy from mesh resolution.

    Surface refinement increases the number of unknowns by roughly four per
    level.  Moving the split one octree level deeper at the same time keeps the
    coarse occupancy in the same range.  Electrically dense meshes use one
    shallower split and larger leaves to limit translation/setup memory.
    """
    electrical_density = (
        args.ka * shortest_wavelength_factor(args) / float(1 << refinement)
    )
    dense_frequency = electrical_density >= 2.0 or dofs >= 2_000_000
    split_depth = max(
        2,
        min(6, refinement - (3 if dense_frequency else 2)),
    )
    # A one-level shallower octree contains roughly eight times more source
    # quadrature points per leaf.  These values reproduce the measured
    # ref6 split-4 (512/256) and split-3 (4096/512) controls and continue that
    # occupancy law to adjacent refinements.
    coarse_max_leaf = max(64, int(512 * (8.0 ** (4 - split_depth))))
    middle_max_leaf = max(64, int(256 * (2.0 ** (4 - split_depth))))
    stage1_tolerance = min(
        8.0e-2,
        max(3.0e-2, 2.0e-2 * shortest_wavelength_factor(args)),
    )
    return {
        "selection": "automatic_by_mesh_and_electrical_density",
        "electrical_density": electrical_density,
        "stage1_tolerance": stage1_tolerance,
        "stage2_maximum_iterations": default_maximum_iterations(args, profile),
        "pfft_grid_safety": 1.0 if dense_frequency else 0.8,
        "banded_split_depth": split_depth,
        "banded_coarse_max_leaf": coarse_max_leaf,
        "banded_middle_max_leaf": middle_max_leaf,
        "banded_coarse_order_reference_depth": (
            None if dense_frequency else max(1, split_depth - 1)
        ),
    }


def two_stage_settings(
    args: argparse.Namespace,
    profile: Profile,
    refinement: int,
) -> dict[str, Any]:
    return automatic_banded_settings(
        args, profile, refinement, estimate_dofs(args, refinement)
    )


def make_two_stage_plan(
    args: argparse.Namespace,
    profile: Profile,
    output: Path,
    refinement: int,
) -> dict[str, Any]:
    output = output.resolve()
    checkpoint = output / "checkpoint"
    settings = two_stage_settings(
        args, profile, refinement
    )
    target_tolerance = selected(args, "tolerance", profile.tolerance)
    final_maximum_iterations = selected(
        args,
        "maximum_iterations",
        default_maximum_iterations(args, profile),
    )
    mbj_nodes = selected(args, "mbj_nodes", default_mbj_nodes(args, profile))
    mbj_overlap = selected(args, "mbj_overlap", 0)
    cache_directory = operator_cache_directory(
        args,
        refinement,
        "smooth" if args.shape == "sphere" else "hdiv",
        selected(args, "quadrature", profile.quadrature),
        selected(args, "duffy_order", profile.duffy_order),
    )

    stage1_args = argparse.Namespace(**vars(args))
    stage1_args.solver = "pfft"
    stage1_args.tolerance = float(settings["stage1_tolerance"])
    stage1_args.fmm_digits = max(5, selected(args, "fmm_digits", profile.fmm_digits))
    stage1_args.maximum_iterations = 3
    stage1_args.max_leaf = 256
    stage1_args.pfft_inner_tolerance = 0.12
    stage1_args.pfft_inner_iterations = "auto"
    stage1_args.pfft_outer_restart = 3
    stage1_args.pfft_order = 2
    stage1_args.pfft_correction_radius = 0.0
    stage1_args.pfft_grid_safety = float(settings["pfft_grid_safety"])
    stage1 = make_single_plan(
        stage1_args, profile, output / "stage1_preview", refinement, "run"
    )
    stage1["kind"] = "two_stage_preview"
    stage1["cache_directory"] = str(cache_directory)
    stage1["effective_parameters"].update({
        "stage": "up_to_three_step_preview",
        "final_residual_verification": "projected_residual_only",
        "physical_output": False,
    })
    stage1_command = stage1["command"]
    replace_command_option(
        stage1_command, "--near-correction-cache",
        str(cache_directory / "operator.near"),
    )
    replace_command_option(
        stage1_command, "--mbj-cache",
        str(cache_directory / f"mbj_n{mbj_nodes}_o{mbj_overlap}.cache"),
    )
    replace_command_option(stage1_command, "--checkpoint", str(checkpoint))
    remove_command_option(stage1_command, "--physical-check")
    remove_command_option(stage1_command, "--ntheta", takes_value=True)
    remove_command_option(stage1_command, "--cyclic-polarization")
    remove_command_option(stage1_command, "--cyclic-exact-geometry")
    stage1_command.insert(
        stage1_command.index("--out"), "--trust-final-projected-residual"
    )
    stage1["runtime"]["environment"].update({
        "BEM_MIXED_ITERATIVE_REFINEMENT": "1",
        "BEM_FMM_PAIR_CURRENTS": "0",
        "BEM_MULLER_GPU_ASSEMBLY": "0",
    })
    two_stage_memory = (
        1.25
        + stage1["estimate"]["system_dofs"] * (14 * 1024) / (1024.0 ** 3)
    )
    stage1["estimate"]["gpu_memory_gib"] = round(two_stage_memory, 2)
    stage1["effective_parameters"]["memory_policy"] = (
        "sequential_currents_two_stage"
    )
    if args.ka >= 100.0:
        stage1["runtime"]["environment"].update({
            "BEM_FMM_L2P_PHASE_CACHE_FP16": "1",
            "BEM_FMM_L2P_PHASE_CACHE_FP16_MB": "1024",
            "BEM_FMM_STRICT_PAIR_WORKSPACE": "0",
        })

    stage2_args = argparse.Namespace(**vars(args))
    stage2_args.solver = "pfft"
    stage2_args.tolerance = target_tolerance
    stage2_args.fmm_digits = max(5, selected(args, "fmm_digits", profile.fmm_digits))
    stage2_args.maximum_iterations = final_maximum_iterations
    stage2_args.max_leaf = 256
    stage2_args.pfft_inner_tolerance = 2.0e-2
    stage2_args.pfft_inner_iterations = "48"
    stage2_args.pfft_outer_restart = 40
    stage2_args.pfft_order = 2
    stage2_args.pfft_correction_radius = 0.0
    stage2_args.pfft_grid_safety = float(settings["pfft_grid_safety"])
    stage2 = make_single_plan(
        stage2_args, profile, output / "final", refinement, "run"
    )
    stage2["kind"] = "two_stage_exact"
    stage2["cache_directory"] = str(cache_directory)
    stage2_command = stage2["command"]
    stage2["effective_parameters"].update({
        "stage": "exact_banded_fmm_corrections",
        "final_residual_verification": "exact_banded_fmm_operator_residual",
        "physical_output": True,
        "validated_residual_target": target_tolerance,
        "polarization_mode": (
            "verified_regular_prism_symmetry_with_correction"
            if "--cyclic-polarization" in stage2_command
            else "independent"
        ),
    })
    replace_command_option(
        stage2_command, "--near-correction-cache",
        str(cache_directory / "operator.near"),
    )
    replace_command_option(
        stage2_command, "--mbj-cache",
        str(cache_directory / f"mbj_n{mbj_nodes}_o{mbj_overlap}.cache"),
    )
    replace_command_option(stage2_command, "--checkpoint", str(checkpoint))
    out_index = stage2_command.index("--out")
    migration_options = ["--allow-checkpoint-migration"]
    stage2_command[out_index:out_index] = migration_options
    stage2["runtime"]["environment"].update({
        "BEM_MIXED_ITERATIVE_REFINEMENT": "1",
        "BEM_FMM_BANDED_SPLIT_DEPTH": str(settings["banded_split_depth"]),
        "BEM_FMM_BANDED_COARSE_MAX_LEAF": str(
            settings["banded_coarse_max_leaf"]
        ),
        "BEM_FMM_BANDED_MIDDLE_MAX_LEAF": str(
            settings["banded_middle_max_leaf"]
        ),
        "BEM_FMM_PAIR_CURRENTS": "0",
        "BEM_MULLER_GPU_ASSEMBLY": "0",
        "BEM_FMM_STRICT_PAIR_WORKSPACE": "0",
    })
    stage2["estimate"]["gpu_memory_gib"] = round(two_stage_memory, 2)
    stage2["effective_parameters"]["memory_policy"] = (
        "sequential_currents_two_stage"
    )
    order_reference_depth = settings["banded_coarse_order_reference_depth"]
    if order_reference_depth is not None:
        stage2["runtime"]["environment"][
            "BEM_FMM_BANDED_COARSE_ORDER_REFERENCE_DEPTH"
        ] = str(order_reference_depth)
    if args.ka >= 100.0 and target_tolerance > 1.0e-5:
        stage2["runtime"]["environment"].update({
            "BEM_FMM_L2P_PHASE_CACHE_FP16": "1",
            "BEM_FMM_L2P_PHASE_CACHE_FP16_MB": "1024",
        })

    envelope = {
        "selection": settings["selection"],
        "shape": args.shape,
        "sides": args.sides if args.shape == "prism" else None,
        "aspect": args.aspect if args.shape == "prism" else None,
        "ka": args.ka,
        "relative_refractive_index": args.ri,
        "refinement": refinement,
        "electrical_density": settings["electrical_density"],
        "theta_samples": stage2["effective_parameters"]["ntheta"],
        "maximum_exact_operator_residual": target_tolerance,
        "operator": "adaptive banded FMM",
        "banded_parameters": {
            "split_depth": settings["banded_split_depth"],
            "coarse_max_leaf": settings["banded_coarse_max_leaf"],
            "middle_max_leaf": settings["banded_middle_max_leaf"],
            "coarse_order_reference_depth": settings[
                "banded_coarse_order_reference_depth"
            ],
            "pfft_grid_safety": settings["pfft_grid_safety"],
        },
    }
    return {
        "schema_version": 1,
        "wrapper_version": VERSION,
        "created_at_utc": utc_now(),
        "kind": "profile_two_stage_suite",
        "calculation_kind": "run",
        "quality": profile.name,
        "output_directory": str(output),
        "cache_directory": str(cache_directory),
        "checkpoint_prefix": str(checkpoint),
        "result_path": stage2["result_path"],
        "children": [stage1, stage2],
        "validation_envelope": envelope,
    }


def fast_uses_pfft_preview(
    args: argparse.Namespace, refinement: int,
) -> bool:
    if args.solver == "fmm":
        return False
    if args.solver == "pfft":
        return True
    return (
        args.ka >= 60.0
        and refinement >= 4
        and estimate_dofs(args, refinement) >= 100_000
    )


def residual_level_slug(tolerance: float) -> str:
    return f"{tolerance:.0e}".replace("e-0", "e-").replace(".", "p")


def make_adaptive_fast_plan(
    args: argparse.Namespace,
    profile: Profile,
    output: Path,
    refinement: int,
) -> dict[str, Any]:
    """Build a residual ladder with observable gates and a standard fallback."""
    if fast_uses_pfft_preview(args, refinement):
        base = make_two_stage_plan(
            args, profile, output, refinement
        )
        preview = base["children"][0]
        exact_template = base["children"][1]
        envelope = dict(base["validation_envelope"])
        checkpoint_prefix = base["checkpoint_prefix"]
        cache_directory = base["cache_directory"]
    else:
        preview = None
        exact_args = argparse.Namespace(**vars(args))
        exact_args.solver = "fmm"
        exact_args.tolerance = profile.tolerance
        exact_template = make_single_plan(
            exact_args,
            profile,
            output / "exact_template",
            refinement,
            "run",
        )
        checkpoint_prefix = str(output / "checkpoint")
        replace_command_option(
            exact_template["command"], "--checkpoint", checkpoint_prefix
        )
        out_index = exact_template["command"].index("--out")
        exact_template["command"].insert(
            out_index, "--allow-checkpoint-migration"
        )
        cache_directory = exact_template["cache_directory"]
        envelope = {
            "selection": "automatic_direct_fmm",
            "shape": args.shape,
            "sides": args.sides if args.shape == "prism" else None,
            "aspect": args.aspect if args.shape == "prism" else None,
            "ka": args.ka,
            "relative_refractive_index": args.ri,
            "refinement": refinement,
            "electrical_density": (
                args.ka * shortest_wavelength_factor(args)
                / float(1 << refinement)
            ),
            "theta_samples": exact_template["effective_parameters"]["ntheta"],
            "operator": "direct FMM",
        }

    exact_stages: list[dict[str, Any]] = []
    for level_index, tolerance in enumerate(FAST_RESIDUAL_LEVELS):
        stage = copy.deepcopy(exact_template)
        slug = residual_level_slug(tolerance)
        stage_output = (output / f"exact_{slug}").resolve()
        stage_result = stage_output / "result.json"
        stage["kind"] = "adaptive_fast_level"
        stage["output_directory"] = str(stage_output)
        stage["result_path"] = str(stage_result)
        stage["effective_parameters"].update({
            "stage": "adaptive_exact_operator_level",
            "adaptive_level_index": level_index,
            "tolerance": tolerance,
            "validated_residual_target": tolerance,
            "final_residual_verification": "exact_fmm_operator_residual",
            "physical_output": True,
        })
        replace_command_option(stage["command"], "--tol", f"{tolerance:.1e}")
        replace_command_option(
            stage["command"],
            "--iteration-log",
            str(stage_output / "iterations.csv"),
        )
        replace_command_option(
            stage["command"], "--checkpoint", checkpoint_prefix
        )
        replace_command_option(stage["command"], "--out", str(stage_result))
        exact_stages.append(stage)

    children = ([preview] if preview is not None else []) + exact_stages
    envelope.update({
        "maximum_exact_operator_residual": profile.tolerance,
        "adaptive_residual_levels": list(FAST_RESIDUAL_LEVELS),
        "observable_relative_tolerance": (
            FAST_OBSERVABLE_RELATIVE_TOLERANCE
        ),
        "required_consecutive_stable_levels": (
            FAST_REQUIRED_CONSECUTIVE_STABLE_LEVELS
        ),
        "minimum_residual_reduction_factor": (
            FAST_MINIMUM_RESIDUAL_REDUCTION_FACTOR
        ),
        "minimum_early_stop_residual": 1.0e-3,
        "fallback": "standard_1e-5",
        "pfft_preview": preview is not None,
    })
    return {
        "schema_version": 1,
        "wrapper_version": VERSION,
        "created_at_utc": utc_now(),
        "kind": "adaptive_fast_suite",
        "calculation_kind": "run",
        "quality": profile.name,
        "output_directory": str(output.resolve()),
        "cache_directory": cache_directory,
        "checkpoint_prefix": checkpoint_prefix,
        "result_path": str((output / "result.json").resolve()),
        "children": children,
        "preview_stage_count": 1 if preview is not None else 0,
        "validation_envelope": envelope,
    }


def has_pipeline_overrides(args: argparse.Namespace) -> bool:
    return any(
        value is not None
        for value in (
            args.max_leaf,
            args.pfft_inner_tolerance,
            args.pfft_inner_iterations,
            args.pfft_outer_restart,
            args.pfft_order,
            args.pfft_correction_radius,
            args.pfft_grid_safety,
        )
    )


def use_automatic_acceleration(
    args: argparse.Namespace,
    profile: Profile,
    refinement: int,
) -> bool:
    dofs = estimate_dofs(args, refinement)
    return (
        not args.single_stage
        and profile.name in {"quick", "standard", "memory"}
        and args.shape in {"sphere", "cube", "prism"}
        and args.ka >= 60.0
        and refinement >= 4
        and dofs >= 100_000
        and args.solver in {"auto", "pfft"}
        and not has_pipeline_overrides(args)
    )


def create_plan(args: argparse.Namespace, kind: str) -> dict[str, Any]:
    if args.ka <= 0.0:
        fail("--ka must be positive")
    if args.ri <= 0.0:
        fail("--ri must be positive")
    profile = PROFILES[QUALITY_ALIASES.get(args.quality, args.quality)]
    if profile.name == "fast":
        if kind != "run":
            fail(
                "adaptive fast currently supports fixed-orientation runs; "
                "use standard or memory for orientation averaging"
            )
        if args.single_stage:
            fail(
                "adaptive fast requires multiple exact residual levels; "
                "use quick or standard with --single-stage"
            )
        if args.tolerance is not None:
            fail(
                "--tol cannot override the adaptive fast residual ladder; "
                "use quick or standard for a fixed residual target"
            )
    if profile.name == "preview":
        preview_case = (
            kind == "run"
            and args.shape == "prism"
            and args.sides == 6
            and math.isclose(args.aspect, 1.0)
            and math.isclose(args.ka, 80.0)
            and math.isclose(args.ri, 1.3)
            and (args.ref is None or args.ref == 6)
            and not args.independent_polarizations
            and args.solver != "fmm"
        )
        if not preview_case:
            fail(
                "the preview profile is validated only for a regular "
                "six-sided prism with ka=80, m=1.3, ref=6, one fixed "
                "orientation, and verified cyclic polarization correction"
            )
    numeric_checks = {
        "--tol": selected(args, "tolerance", profile.tolerance),
        "--digits": selected(args, "fmm_digits", profile.fmm_digits),
        "--duffy-order": selected(args, "duffy_order", profile.duffy_order),
        "--ntheta": selected(args, "ntheta", profile.ntheta),
        "--max-iters": selected(
            args, "maximum_iterations", profile.maximum_iterations
        ),
        "--max-leaf": selected(args, "max_leaf", profile.max_leaf),
        "--mbj-nodes": selected(args, "mbj_nodes", 50),
        "--pfft-inner-tol": selected(args, "pfft_inner_tolerance", 4.0e-2),
        "--pfft-outer-restart": selected(args, "pfft_outer_restart", 40),
        "--pfft-order": selected(args, "pfft_order", 2),
        "--pfft-grid-safety": selected(args, "pfft_grid_safety", 1.0),
    }
    for option, value in numeric_checks.items():
        if float(value) <= 0.0:
            fail(f"{option} must be positive")
    if selected(args, "ntheta", profile.ntheta) < 2:
        fail("--ntheta must be at least 2")
    if (
        profile.name == "fast"
        and selected(args, "ntheta", profile.ntheta) < 3
    ):
        fail("adaptive fast requires --ntheta at least 3 for angular integrals")
    if selected(args, "gmres_restart", profile.gmres_restart) < 0:
        fail("--gmres-restart must be non-negative")
    if selected(args, "mbj_overlap", 0) < 0:
        fail("--mbj-overlap must be non-negative")
    if selected(args, "pfft_correction_radius", 0.0) < 0.0:
        fail("--pfft-correction-radius must be non-negative")
    pfft_order = selected(args, "pfft_order", 2)
    if pfft_order < 2 or pfft_order > 5:
        fail("--pfft-order must be in [2,5]")
    pfft_grid_safety = selected(args, "pfft_grid_safety", 1.0)
    if pfft_grid_safety <= 0.5 or pfft_grid_safety > 1.0:
        fail("--pfft-grid-safety must be in (0.5,1]")
    pfft_inner_tolerance = selected(args, "pfft_inner_tolerance", 4.0e-2)
    if pfft_inner_tolerance >= 1.0:
        fail("--pfft-inner-tol must be in (0,1)")
    inner_iterations = selected(args, "pfft_inner_iterations", "auto")
    if inner_iterations != "auto":
        try:
            if int(inner_iterations) < 1:
                raise ValueError
        except ValueError:
            fail("--pfft-inner-iters must be 'auto' or a positive integer")
    refinement = automatic_refinement(args, profile)
    output = Path(args.out).expanduser() if args.out else default_output(args)
    output = output.resolve()

    if profile.name == "fast":
        return make_adaptive_fast_plan(
            args, profile, output, refinement
        )

    if kind == "run" and use_automatic_acceleration(
        args, profile, refinement
    ):
        return make_two_stage_plan(
            args, profile, output, refinement
        )

    if not profile.two_meshes:
        return make_single_plan(args, profile, output, refinement, kind)

    coarse = make_single_plan(args, profile, output / "coarse", refinement, kind)
    fine = make_single_plan(args, profile, output / "fine", refinement + 1, kind)
    fine["inputs"]["refinement_selection"] = "strict_fine"
    return {
        "schema_version": 1,
        "wrapper_version": VERSION,
        "created_at_utc": utc_now(),
        "kind": "strict_suite",
        "calculation_kind": kind,
        "quality": "strict",
        "output_directory": str(output),
        "children": [coarse, fine],
        "comparison": {
            "coarse": coarse["result_path"],
            "fine": fine["result_path"],
            "maximum_normalized_relative_l2": 0.05,
            "maximum_forward_relative_difference": 0.05,
        },
    }


