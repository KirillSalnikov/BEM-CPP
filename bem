def fail(message: str, code: int = 2) -> NoReturn:
    print(f"bem: {message}", file=sys.stderr)
    raise SystemExit(code)


def number_slug(value: float) -> str:
    return f"{value:g}".replace("-", "m").replace(".", "p")


def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def default_output(args: argparse.Namespace) -> Path:
    stamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    name = (
        f"{args.shape}_ka{number_slug(args.ka)}_"
        f"m{number_slug(args.ri)}_{args.quality}_{stamp}"
    )
    return ROOT / "runs" / name


def base_edge_scale(args: argparse.Namespace) -> float:
    if args.shape == "prism":
        return max(2.0 * math.sin(math.pi / args.sides), args.aspect)
    if args.shape == "cube":
        return 1.0
    return 1.0


def automatic_refinement(args: argparse.Namespace, profile: Profile) -> int:
    if args.ref is not None:
        if args.ref < 0:
            fail("--ref must be non-negative")
        return args.ref
    if args.shape == "obj":
        fail("automatic refinement is unsafe for OBJ meshes; specify --ref")
    points_per_wavelength = (
        args.points_per_wavelength
        if args.points_per_wavelength is not None
        else profile.points_per_wavelength
    )
    if points_per_wavelength <= 0.0:
        fail("--points-per-wavelength must be positive")
    required = (
        points_per_wavelength
        * args.ka
        * base_edge_scale(args)
        / (2.0 * math.pi)
    )
    return max(profile.minimum_refinement, int(math.ceil(math.log2(max(1.0, required)))))


def obj_triangle_count(path: Path) -> int:
    try:
        with path.open(encoding="utf-8", errors="ignore") as stream:
            return sum(1 for line in stream if line.startswith("f "))
    except OSError as error:
        fail(f"cannot read OBJ mesh {path}: {error}")


def estimate_dofs(args: argparse.Namespace, refinement: int) -> int:
    scale = 4 ** refinement
    if args.shape == "sphere":
        return 160 * scale + 8
    if args.shape == "obj":
        triangles = obj_triangle_count(Path(args.obj))
        return max(1, 6 * triangles * scale)
    sides = 4 if args.shape == "cube" else args.sides
    return 36 * sides * scale


def estimate_memory_gib(profile: Profile, dofs: int, pfft_fgmres: bool) -> float:
    # Conservative empirical envelope from the 24 GiB release-machine runs.
    bytes_per_dof = 28 * 1024 if pfft_fgmres else (
        26 * 1024 if not profile.mixed_precision else 20 * 1024
    )
    fixed_gib = 2.0 if pfft_fgmres else 1.0
    return fixed_gib + dofs * bytes_per_dof / (1024.0 ** 3)


def gpu_memory_gib(index: int) -> float | None:
    executable = shutil.which("nvidia-smi")
    if not executable:
        return None
    process = subprocess.run(
        [
            executable,
            f"--id={index}",
            "--query-gpu=memory.total",
            "--format=csv,noheader,nounits",
        ],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if process.returncode != 0:
        return None
    try:
        return float(process.stdout.splitlines()[0].strip()) / 1024.0
    except (IndexError, ValueError):
        return None


def binary_for(args: argparse.Namespace, profile: Profile) -> tuple[Path, str]:
    if args.binary:
        return Path(args.binary).expanduser().resolve(), ""
    if profile.mixed_precision:
        return ROOT / "bin" / "muller_nodal_fmm_demo_fp32", "muller-fp32"
    return ROOT / "bin" / "muller_nodal_fmm_demo", "bin/muller_nodal_fmm_demo"


def shape_arguments(args: argparse.Namespace) -> list[str]:
    if args.shape == "prism":
        if args.sides < 3:
            fail("--sides must be at least 3")
        if args.aspect <= 0.0:
            fail("--aspect must be positive")
        return ["--shape", "prism", "--sides", str(args.sides), "--aspect", str(args.aspect)]
    if args.shape == "cube":
        return ["--shape", "cube"]
    if args.shape == "sphere":
        return ["--shape", "sphere"]
    obj = Path(args.obj).expanduser().resolve() if args.obj else None
    if not obj or not obj.is_file():
        fail("--shape obj requires an existing --obj FILE")
    return ["--shape", "obj", "--obj", str(obj)]


def use_pfft_fgmres(args: argparse.Namespace, profile: Profile) -> bool:
    if args.solver == "fmm":
        return False
    if args.solver == "pfft":
        return True
    return profile.solver_policy == "adaptive_pfft" and args.ka >= 10.0


def solver_label(value: str) -> str:
    return "FMM+pFFT-FGMRES" if value == "fmm_pfft_fgmres" else "FMM+MBJ"


def solver_arguments(
    pfft_fgmres: bool,
    mbj_nodes: int,
    mbj_overlap: int,
    pfft_inner_tolerance: float,
    pfft_inner_iterations: str,
    pfft_outer_restart: int,
    pfft_order: int,
    pfft_correction_radius: float,
    pfft_grid_safety: float,
) -> list[str]:
    arguments = [
        "--mbj-only",
        "--mbj-nodes", str(mbj_nodes),
        "--mbj-overlap", str(mbj_overlap),
    ]
    if pfft_fgmres:
        arguments += [
            "--pfft-fgmres",
            "--pfft-inner-tol", f"{pfft_inner_tolerance:g}",
            "--pfft-inner-iters", pfft_inner_iterations,
            "--pfft-outer-restart", str(pfft_outer_restart),
            "--pfft-order", str(pfft_order),
            "--pfft-correction-radius", f"{pfft_correction_radius:g}",
            "--pfft-grid-safety", f"{pfft_grid_safety:g}",
        ]
    return arguments


def effective_max_leaf(args: argparse.Namespace, profile: Profile) -> int:
    if args.max_leaf is not None:
        return args.max_leaf
    # Shallow trees avoid unstable mixed-precision translations on small cases.
    if profile.mixed_precision and args.ka < 5.0:
        return 128
    return profile.max_leaf


def selected(args: argparse.Namespace, name: str, default: Any) -> Any:
    value = getattr(args, name, None)
    return default if value is None else value


def orientation_parameters(
    args: argparse.Namespace,
    profile: Profile,
    output: Path,
    pfft_fgmres: bool,
) -> tuple[list[str], dict[str, Any]]:
    adaptive_override = any(
        value is not None
        for value in (
            args.adaptive_levels,
            args.adaptive_m11_tolerance,
            args.adaptive_integral_tolerance,
            args.adaptive_component_tolerance,
        )
    )
    fixed_requested = args.fixed_grid or args.beta is not None or args.gamma is not None
    if adaptive_override and fixed_requested:
        fail("adaptive averaging controls cannot be combined with --fixed-grid/--beta/--gamma")
    adaptive = adaptive_override or not fixed_requested

    alpha = selected(args, "alpha", 8)
    if alpha < 1:
        fail("--alpha must be positive")
    symmetry = args.symmetry_order
    if symmetry is None:
        symmetry = args.sides if args.shape == "prism" else (
            4 if args.shape == "cube" else 1
        )
    if symmetry < 1:
        fail("--symmetry-order must be positive")

    warm_angle = selected(args, "orient_warm_max_angle", 25.0)
    recycle_rank = selected(
        args, "orient_recycle_rank", profile.orientation_recycle_rank
    )
    if warm_angle <= 0.0:
        fail("--orient-warm-max-angle must be positive")
    if recycle_rank < 0 or recycle_rank > 128:
        fail("--orient-recycle-rank must be in [0,128]")

    arguments: list[str]
    details: dict[str, Any]
    if adaptive:
        levels = args.adaptive_levels or (
            profile.orientation_minimum_level,
            profile.orientation_maximum_level,
        )
        minimum_level, maximum_level = levels
        if minimum_level < 1 or maximum_level <= minimum_level or maximum_level > 15:
            fail("--adaptive-levels requires 1 <= MIN < MAX <= 15")
        m11_tolerance = selected(
            args, "adaptive_m11_tolerance", profile.orientation_m11_tolerance
        )
        integral_tolerance = selected(
            args,
            "adaptive_integral_tolerance",
            profile.orientation_integral_tolerance,
        )
        component_tolerance = selected(
            args,
            "adaptive_component_tolerance",
            profile.orientation_component_tolerance,
        )
        if min(m11_tolerance, integral_tolerance, component_tolerance) < 0.0:
            fail("adaptive averaging tolerances must be non-negative")
        beta_nodes = (1 << maximum_level) + 1
        gamma_nodes = 1 << maximum_level
        parts = output / "orientation_parts"
        arguments = [
            "--orient-average", str(alpha), str(beta_nodes), str(gamma_nodes),
            "--orient-adaptive", str(minimum_level), str(maximum_level),
            "--orient-adaptive-m11-tol", f"{m11_tolerance:g}",
            "--orient-adaptive-integral-tol", f"{integral_tolerance:g}",
            "--orient-adaptive-component-tol", f"{component_tolerance:g}",
            "--orient-parts-dir", str(parts),
        ]
        details = {
            "mode": "adaptive",
            "alpha": alpha,
            "minimum_level": minimum_level,
            "maximum_level": maximum_level,
            "maximum_beta_nodes": beta_nodes,
            "maximum_gamma_nodes": gamma_nodes,
            "maximum_base_orientations": beta_nodes * gamma_nodes,
            "m11_tolerance": m11_tolerance,
            "integral_tolerance": integral_tolerance,
            "component_tolerance": component_tolerance,
            "parts_directory": str(parts),
        }
    else:
        beta = selected(args, "beta", 8)
        gamma = selected(args, "gamma", 4)
        if beta < 1 or gamma < 1:
            fail("--beta and --gamma must be positive")
        arguments = ["--orient-average", str(alpha), str(beta), str(gamma)]
        details = {
            "mode": "fixed",
            "alpha": alpha,
            "beta": beta,
            "gamma": gamma,
            "base_orientations": beta * gamma,
        }

    arguments += [
        "--orient-symmetry-order", str(symmetry),
        "--orient-warm-max-angle", f"{warm_angle:g}",
        "--orient-recycle-rank", str(recycle_rank),
    ]
    if args.orient_zero_start:
        arguments.append("--orient-zero-start")
    paired = selected(args, "orient_paired_gpu_gmres", not pfft_fgmres)
    if pfft_fgmres and paired:
        fail("paired GPU GMRES is incompatible with pFFT-FGMRES averaging")
    arguments.append(
        "--orient-paired-gpu-gmres"
        if paired else "--no-orient-paired-gpu-gmres"
    )
    details.update(
        {
            "symmetry_order": symmetry,
            "warm_start": not args.orient_zero_start,
            "warm_start_max_angle_degrees": warm_angle,
            "recycle_rank": recycle_rank,
            "paired_gpu_gmres": paired,
        }
    )
    return arguments, details


def make_single_plan(
    args: argparse.Namespace,
    profile: Profile,
    output: Path,
    refinement: int,
    kind: str,
) -> dict[str, Any]:
    output = output.resolve()
    binary, build_target = binary_for(args, profile)
    edge_mode = "smooth" if args.shape == "sphere" else "hdiv"
    max_leaf = effective_max_leaf(args, profile)
    pfft_fgmres = use_pfft_fgmres(args, profile)
    tolerance = selected(args, "tolerance", profile.tolerance)
    quadrature = selected(args, "quadrature", profile.quadrature)
    duffy_order = selected(args, "duffy_order", profile.duffy_order)
    fmm_digits = selected(args, "fmm_digits", profile.fmm_digits)
    maximum_iterations = selected(
        args, "maximum_iterations", profile.maximum_iterations
    )
    gmres_restart = selected(args, "gmres_restart", profile.gmres_restart)
    ntheta = selected(args, "ntheta", profile.ntheta)
    mbj_nodes = selected(args, "mbj_nodes", 50)
    mbj_overlap = selected(args, "mbj_overlap", 0)
    pfft_inner_tolerance = selected(args, "pfft_inner_tolerance", 4.0e-2)
    pfft_inner_iterations = selected(args, "pfft_inner_iterations", "auto")
    pfft_outer_restart = selected(args, "pfft_outer_restart", 32)
    pfft_order = selected(args, "pfft_order", 2)
    pfft_correction_radius = selected(args, "pfft_correction_radius", 0.0)
    pfft_grid_safety = selected(args, "pfft_grid_safety", 1.0)
    points_per_wavelength = selected(
        args, "points_per_wavelength", profile.points_per_wavelength
    )
    achieved_points_per_wavelength = None
    if args.shape != "obj":
        achieved_points_per_wavelength = (
            2.0 * math.pi * (1 << refinement)
            / (args.ka * base_edge_scale(args))
        )
    dofs = estimate_dofs(args, refinement)
    result = output / "result.json"
    command = [str(binary)]
    command += shape_arguments(args)
    command += [
        "--ref", str(refinement),
        "--ka", f"{args.ka:g}",
        "--ri", f"{args.ri:g}",
        "--edge-mode", edge_mode,
        "--quad", str(quadrature),
        "--duffy-order", str(duffy_order),
        "--digits", str(fmm_digits),
        "--max-leaf", str(max_leaf),
        "--fmm-near-radius", "3",
        "--tol", f"{tolerance:.1e}",
        "--max-iters", str(maximum_iterations),
        "--gmres-restart", str(gmres_restart),
    ]
    command += solver_arguments(
        pfft_fgmres,
        mbj_nodes,
        mbj_overlap,
        pfft_inner_tolerance,
        str(pfft_inner_iterations),
        pfft_outer_restart,
        pfft_order,
        pfft_correction_radius,
        pfft_grid_safety,
    )
    command += [
        "--fmm-near-fp32" if profile.mixed_precision else "--fmm-near-fp64",
        "--near-correction-cache", str(output / "operator.near"),
        "--mbj-cache", str(output / f"mbj{mbj_nodes}.cache"),
        "--physical-check",
        "--ntheta", str(ntheta),
        "--no-dense-validation",
        "--iteration-log", str(output / "iterations.csv"),
    ]

    orientation: dict[str, Any] | None = None
    if kind == "average":
        orientation_arguments, orientation = orientation_parameters(
            args, profile, output, pfft_fgmres
        )
        command += orientation_arguments

    command += ["--out", str(result)]
    memory = estimate_memory_gib(profile, dofs, pfft_fgmres)
    return {
        "schema_version": 1,
        "wrapper_version": VERSION,
        "created_at_utc": utc_now(),
        "kind": kind,
        "quality": profile.name,
        "profile": asdict(profile),
        "effective_parameters": {
            "max_leaf": max_leaf,
            "near_precision": "fp32" if profile.mixed_precision else "fp64",
            "solver": "fmm_pfft_fgmres" if pfft_fgmres else "fmm_mbj",
            "tolerance": tolerance,
            "quadrature": quadrature,
            "duffy_order": duffy_order,
            "fmm_digits": fmm_digits,
            "maximum_iterations": maximum_iterations,
            "gmres_restart": gmres_restart,
            "ntheta": ntheta,
            "mbj_nodes": mbj_nodes,
            "mbj_overlap": mbj_overlap,
            "pfft_inner_tolerance": pfft_inner_tolerance,
            "pfft_inner_iterations": pfft_inner_iterations,
            "pfft_outer_restart": pfft_outer_restart,
            "pfft_order": pfft_order,
            "pfft_correction_radius": pfft_correction_radius,
            "pfft_grid_safety": pfft_grid_safety,
            "orientation": orientation,
        },
        "inputs": {
            "shape": args.shape,
            "ka": args.ka,
            "relative_refractive_index": args.ri,
            "refinement": refinement,
            "refinement_selection": "explicit" if args.ref is not None else "automatic",
            "target_points_per_exterior_wavelength": points_per_wavelength,
            "estimated_points_per_exterior_wavelength": achieved_points_per_wavelength,
            "sides": args.sides if args.shape == "prism" else None,
            "aspect": args.aspect if args.shape == "prism" else None,
            "obj": str(Path(args.obj).expanduser().resolve()) if args.obj else None,
        },
        "estimate": {
            "system_dofs": dofs,
            "gpu_memory_gib": round(memory, 2),
            "note": "conservative estimate; setup-only reports actual allocation",
        },
        "runtime": {
            "binary": str(binary),
            "build_target": build_target,
            "threads": args.threads,
            "gpu": args.gpu,
            "cxx": args.cxx,
            "cuda_home": args.cuda_home,
            "environment": (
                {"BEM_MULLER_GPU_ASSEMBLY": "1"}
                if kind == "average" else {}
            ),
        },
        "output_directory": str(output),
        "result_path": str(result),
        "command": command,
    }


def create_plan(args: argparse.Namespace, kind: str) -> dict[str, Any]:
    if args.ka <= 0.0:
        fail("--ka must be positive")
    if args.ri <= 0.0:
        fail("--ri must be positive")
    profile = PROFILES[args.quality]
    numeric_checks = {
        "--tol": selected(args, "tolerance", profile.tolerance),
        "--digits": selected(args, "fmm_digits", profile.fmm_digits),
        "--duffy-order": selected(args, "duffy_order", profile.duffy_order),
        "--ntheta": selected(args, "ntheta", profile.ntheta),
        "--max-iters": selected(
            args, "maximum_iterations", profile.maximum_iterations
        ),
        "--max-leaf": selected(args, "max_leaf", profile.max_leaf),
        "--mbj-nodes": selected(args, "mbj_nodes", 50),
        "--pfft-inner-tol": selected(args, "pfft_inner_tolerance", 4.0e-2),
        "--pfft-outer-restart": selected(args, "pfft_outer_restart", 32),
        "--pfft-order": selected(args, "pfft_order", 2),
        "--pfft-grid-safety": selected(args, "pfft_grid_safety", 1.0),
    }
    for option, value in numeric_checks.items():
        if float(value) <= 0.0:
            fail(f"{option} must be positive")
    if selected(args, "ntheta", profile.ntheta) < 2:
        fail("--ntheta must be at least 2")
    if selected(args, "gmres_restart", profile.gmres_restart) < 0:
        fail("--gmres-restart must be non-negative")
    if selected(args, "mbj_overlap", 0) < 0:
        fail("--mbj-overlap must be non-negative")
    if selected(args, "pfft_correction_radius", 0.0) < 0.0:
        fail("--pfft-correction-radius must be non-negative")
    pfft_order = selected(args, "pfft_order", 2)
    if pfft_order < 2 or pfft_order > 5:
        fail("--pfft-order must be in [2,5]")
    pfft_grid_safety = selected(args, "pfft_grid_safety", 1.0)
    if pfft_grid_safety <= 0.5 or pfft_grid_safety > 1.0:
        fail("--pfft-grid-safety must be in (0.5,1]")
    pfft_inner_tolerance = selected(args, "pfft_inner_tolerance", 4.0e-2)
    if pfft_inner_tolerance >= 1.0:
        fail("--pfft-inner-tol must be in (0,1)")
    inner_iterations = selected(args, "pfft_inner_iterations", "auto")
    if inner_iterations != "auto":
        try:
            if int(inner_iterations) < 1:
                raise ValueError
        except ValueError:
            fail("--pfft-inner-iters must be 'auto' or a positive integer")
    refinement = automatic_refinement(args, profile)
    output = Path(args.out).expanduser() if args.out else default_output(args)
    output = output.resolve()

    if not profile.two_meshes:
        return make_single_plan(args, profile, output, refinement, kind)

    coarse = make_single_plan(args, profile, output / "coarse", refinement, kind)
    fine = make_single_plan(args, profile, output / "fine", refinement + 1, kind)
    fine["inputs"]["refinement_selection"] = "strict_fine"
    return {
        "schema_version": 1,
        "wrapper_version": VERSION,
        "created_at_utc": utc_now(),
        "kind": "strict_suite",
        "calculation_kind": kind,
        "quality": "strict",
        "output_directory": str(output),
        "children": [coarse, fine],
        "comparison": {
            "coarse": coarse["result_path"],
            "fine": fine["result_path"],
            "maximum_normalized_relative_l2": 0.05,
            "maximum_forward_relative_difference": 0.05,
        },
    }


def print_plan(plan: dict[str, Any], as_json: bool = False) -> None:
    if as_json:
        print(json.dumps(plan, indent=2, ensure_ascii=False))
        return
