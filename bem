    parser.add_argument("--yes", action="store_true", help="confirm strict two-grid execution")
    parser.add_argument("--json", action="store_true", help="print the effective plan as JSON")
    parser.add_argument("--solver", choices=("auto", "fmm", "pfft"), default="auto")
    parser.add_argument("--tol", dest="tolerance", type=float)
    parser.add_argument("--digits", dest="fmm_digits", type=int)
