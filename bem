    print(f"  precision: {precision}")
    print(f"  residual target: {profile.tolerance:.0e}")
    print(f"  angular samples: {profile.ntheta}")
    if profile.solver_policy == "adaptive_pfft":
        print("  solver: FMM+MBJ for ka<10; FMM+pFFT-FGMRES for ka>=10")
    else:
        print("  solver: FMM with MBJ")
    print(f"  automatic mesh target: {profile.points_per_wavelength:g} points/wavelength")
    print(
        "  adaptive averaging: "
        f"J={profile.orientation_minimum_level}..{profile.orientation_maximum_level}, "
        f"M11/integral/component tolerances "
        f"{profile.orientation_m11_tolerance:g}/"
        f"{profile.orientation_integral_tolerance:g}/"
        f"{profile.orientation_component_tolerance:g}"
    )
